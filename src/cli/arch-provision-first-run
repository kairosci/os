#!/bin/bash

# arch:summary=Finish first-login setup for Arch.
# arch:args=[--force]
# arch:hidden=true

set -e

usage() {
  cat <<USAGE
Usage: arch-provision-first-run [--force]

Run first-login user setup and notification hooks. By default this only runs
once per user.
USAGE
}

force=0
finalize_user_args=()
while (($#)); do
  case "$1" in
    --force)
      force=1
      finalize_user_args+=(--force)
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir=~/.local/state/arch
FIRST_RUN_DONE="first-run-user"
if arch-done check "$FIRST_RUN_DONE" && (( force == 0 )); then
  echo "First-run already complete."
  exit 0
fi

arch-provision-user "${finalize_user_args[@]}" || true

mkdir -p "$state_dir"

FIRST_RUN_LOG="$state_dir/first-run.log"
first_run_failed=0

log_first_run() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$FIRST_RUN_LOG"
}

run_first_run_step() {
  local name="$1"
  shift

  log_first_run "Starting: $name"
  if "$@"; then
    log_first_run "Completed: $name"
  else
    local status=$?
    first_run_failed=1
    log_first_run "Failed: $name (exit code: $status)"
  fi
}

run_first_run_step "install fingerprint setup post-update hook" \
  arch-hook-install post-update "$ARCH_PATH/installer/user/first-run/setup-fingerprint.hook"
run_first_run_step "install agent setup post-update hook" \
  arch-hook-install post-update "$ARCH_PATH/installer/user/first-run/setup-agent.hook"

run_first_run_step "enable user systemd units" \
  bash "$ARCH_PATH/installer/user/first-run/enable-user-units.sh"
# Finalization ran it too, maybe without a session; the platform finishes what
# needs one here.
run_first_run_step "run the platform's user setup" \
  arch-lifecycle-dispatch setup-user
run_first_run_step "set GNOME theme" \
  python3 -I "$ARCH_PATH/src/python/installer_user/first_run/commands.py" gnome_theme
run_first_run_step "set GTK primary paste" \
  python3 -I "$ARCH_PATH/src/python/installer_user/first_run/commands.py" gtk_primary_paste
run_first_run_step "apply speaker tuning" \
  python3 -I "$ARCH_PATH/src/python/installer_user/first_run/commands.py" audio_tuning

arch-notification-wait || log_first_run "Timed out waiting for notification service; continuing"
# Each send returns only once the server has taken the toast, so sending in
# order is enough to stack them newest-on-top.
run_first_run_step "show welcome notification" \
  python3 -I "$ARCH_PATH/src/python/installer_user/first_run/commands.py" welcome
run_first_run_step "schedule Wi-Fi/update notifications" \
  bash "$ARCH_PATH/installer/user/first-run/wifi.sh"

if (( first_run_failed == 0 )); then
  arch-done mark "$FIRST_RUN_DONE"
else
  log_first_run "One or more first-run steps failed; first-run will retry next login"
fi
