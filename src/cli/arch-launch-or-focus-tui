#!/bin/bash

# arch:summary=Launch a TUI or focus an existing terminal window for it
# arch:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.arch.$(basename "$1")"
fi

LAUNCH_COMMAND="arch-launch-tui $@"

exec arch-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
