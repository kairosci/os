#!/bin/bash

# arch:summary=Print the window class Chromium gives a web app opened at a URL
# arch:args=<url>
# arch:hidden=true

# Chromium names an --app window after the URL's host and path, so a web app's
# launcher can match it through StartupWMClass and the dock shows its app name.

url=${1:-}
if [[ -z $url ]]; then
  echo "Usage: arch-webapp-window-class <url>" >&2
  exit 1
fi

address=${url#*://}
address=${address%%[?#]*}
host=${address%%/*}
path=${address:${#host}}
host=${host##*@}
host=${host%%:*}

printf 'chrome-%s_%s-Default\n' "${host,,}" "${path:-/}" | sed 's|/|_|g'
