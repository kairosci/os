#!/bin/bash

# arch:summary=Run pending Arch system migrations.
# arch:args=[--pending]

set -euo pipefail

mode="run"

usage() {
  echo "Usage: arch-migrate [--pending]"
}

while (($#)); do
  case "$1" in
    --pending|--check)
      mode="pending"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

ARCH_PATH="${ARCH_PATH:-/usr/share/arch}"
STATE_DIR="${ARCH_MIGRATION_STATE:-$HOME/.local/state/arch/migrations}"
LEGACY_STATE_DIR="${ARCH_LEGACY_MIGRATION_STATE:-$HOME/.local/state/arch/migrations}"
LEGACY_OS_STATE_DIR="${ARCH_OS_LEGACY_MIGRATION_STATE:-$HOME/.local/state/os/migrations}"
MIGRATIONS_DIR="$ARCH_PATH/migrations"

migration_entries() {
  [[ -d $MIGRATIONS_DIR ]] || return 0

  local file filename

  for file in "$MIGRATIONS_DIR"/*.sh; do
    [[ -f $file ]] || continue
    filename=$(basename "$file")
    local marker="$STATE_DIR/$filename"
    if [[ ! -f $marker ]]; then
      if [[ -f $LEGACY_OS_STATE_DIR/$filename ]]; then
        marker="$LEGACY_OS_STATE_DIR/$filename"
      elif [[ -f $LEGACY_STATE_DIR/$filename ]]; then
        marker="$LEGACY_STATE_DIR/$filename"
      fi
    fi
    printf '%s\t%s\t%s\n' "$filename" "$file" "$marker"
  done
}

pending_migrations() {
  local name file marker

  while IFS=$'\t' read -r name file marker; do
    [[ -n $name ]] || continue
    if [[ ! -f $marker ]]; then
      printf '%s\n' "$name"
    fi
  done < <(migration_entries)
}

if [[ $mode == "pending" ]]; then
  pending_output=$(pending_migrations)
  if [[ -n $pending_output ]]; then
    printf '%s\n' "$pending_output"
    exit 0
  else
    exit 1
  fi
fi

wait_for_pacman_transaction() {
  local lock_file=/var/lib/pacman/db.lck

  [[ -e $lock_file ]] || return 0
  echo "Waiting for pacman transaction to finish before running Arch migrations..."

  for _ in {1..900}; do
    [[ -e $lock_file ]] || return 0
    sleep 1
  done

  echo "Pacman transaction is still running; Arch migrations will retry on next login."
  exit 0
}

wait_for_pacman_transaction

mkdir -p "$STATE_DIR"
[[ -d $MIGRATIONS_DIR ]] || exit 0

while IFS=$'\t' read -r name file marker <&3; do
  [[ -n $name ]] || continue

  if [[ ! -f $marker ]]; then
    echo -e "\e[32m\nRunning migration (${name%.sh})\e[0m"
    if ARCH_PATH="$ARCH_PATH" ARCH_PATH="$ARCH_PATH" bash -euo pipefail "$file" 3<&-; then
      :
    else
      migration_status=$?
      if ((migration_status == 75)); then
        echo "Migration $name is deferred; continuing with independent migrations."
        continue
      fi
      exit "$migration_status"
    fi
    mkdir -p "$(dirname "$marker")"
    touch "$marker"
  fi
done 3< <(migration_entries)

# Clear a login-time notification the user left sitting there and then resolved
# by running migrations some other way. The substring matches both the current
# and legacy notification titles.
arch-notification-dismiss "Migrations" >/dev/null 2>&1 || true
