#!/bin/bash

# arch:summary=Set the default coding agent
# arch:args=[claude|codex]
# arch:examples=archctl default agent | archctl default agent codex | archctl default agent claude

agent_file="$HOME/.config/arch/defaults/agent"

if (($# == 0)); then
  if [[ -f $agent_file ]]; then
    read -r agent <"$agent_file"
  fi

  [[ -n ${agent:-} ]] && echo "$agent"
  exit 0
fi

case "$1" in
claude) agent="claude" ;;
codex) agent="codex" ;;
*)
  arch-i18n agent.defaultUsage >&2
  exit 1
  ;;
esac

if arch-cmd-missing "$agent"; then
  arch-i18n agent.notInstalled "$agent" >&2
  exit 1
fi

mkdir -p "$(dirname "$agent_file")"
printf '%s\n' "$agent" >"$agent_file"
exec arch-agent
