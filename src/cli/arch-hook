#!/bin/bash

# arch:summary=Run a named hook from ~/.config/arch/hooks/<name> and ~/.config/arch/hooks/<name>.d/.
# arch:args=[name] [args...]

set -e

if (( $# < 1 )); then
  echo "Usage: arch-hook [name] [args...]"
  exit 1
fi

HOOK=$1

# Hook names are fixed labels chosen by os code (post-update, theme-set,
# font-set). The name becomes a filename under the hooks directory. A slash
# would turn it into directory levels, and a bare `.` or `..` would point bash
# at the directory itself or its parent. Refuse those rather than follow them.
# Dots inside a name (a..b) are fine; once slashes are out, only the whole
# name being `.` or `..` can leave the directory.
if [[ -z $HOOK || $HOOK == */* || $HOOK == "." || $HOOK == ".." ]]; then
  echo "Invalid hook name: $HOOK" >&2
  exit 2
fi

HOOK_PATH="$HOME/.config/arch/hooks/$1"
HOOK_DIR="$HOOK_PATH.d"
shift

run_hook() {
  local hook="$1"
  shift

  if [[ $hook == *.py ]]; then
    python3 -I "$hook" "$@"
  else
    bash "$hook" "$@"
  fi
}

if [[ -f $HOOK_PATH ]]; then
  run_hook "$HOOK_PATH" "$@" || echo "Hook failed: $HOOK_PATH"
fi

if [[ -d $HOOK_DIR ]]; then
  for hook in "$HOOK_DIR"/*; do
    [[ -f $hook ]] || continue
    [[ $hook == *.sample ]] && continue
    run_hook "$hook" "$@" || echo "Hook failed: $hook"
  done
fi
