#!/bin/bash

# arch:summary=List available themes
# arch:examples=archctl theme list | archctl theme set "Tokyo Night"

{
  find ~/.config/arch/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$ARCH_PATH/assets/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
