#!/bin/bash

# arch:summary=Take a screenshot
# arch:group=capture
# arch:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# arch:examples=archctl screenshot | archctl capture screenshot region
# arch:aliases=archctl screenshot

if [[ -n ${ARCH_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$ARCH_SCREENSHOT_DIR"
fi

omasnap_args=()
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
