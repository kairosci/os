#!/bin/bash

# arch:summary=Finalize Arch user setup (runtime tweaks /etc/skel can't do)
# arch:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: arch finalize user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
xdg-user-dirs + gtk bookmarks (need \$HOME), default browser/mailto, and the
Python setup steps declared in data/installer/user-setup.yml.

For shipped configs see /etc/skel (new users) and arch-reinstall-configs
(existing users explicitly resyncing).

--first-install is used by the ISO in the target chroot. It marks shipped
migrations complete for the freshly-created user.

Idempotency marker: ~/.local/state/arch/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run arch-provision-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/arch"
mkdir -p "$state_dir"

if arch-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete."
  exit 0
fi

export ARCH_PATH="${ARCH_PATH:-/usr/share/arch}"
export ARCH_INSTALL="${ARCH_INSTALL:-$ARCH_PATH/installer}"
export ARCH_SETUP_CONTEXT="${ARCH_SETUP_CONTEXT:-runtime}"
export PATH="$ARCH_PATH/src/cli:$PATH"

if (( first_install )) && [[ $ARCH_SETUP_CONTEXT == "runtime" ]]; then
  # The ISO chroot doesn't set a context; arch-provision-owner runs first-install
  # finalization too but with ARCH_SETUP_CONTEXT=provision-owner already set.
  export ARCH_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${ARCH_INSTALL_LOG_FILE:-} && -f $ARCH_INSTALL/helpers/logging.sh ]]; then
  source "$ARCH_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    if [[ $script == *.py ]]; then
      python3 -I "$script"
    else
      bash -eE -c 'source "$1"' bash "$script"
    fi
  }
fi

mkdir -p ~/Downloads ~/Pictures ~/Videos ~/.config/gtk-3.0
xdg-user-dirs-update --set TEMPLATES "$HOME"
xdg-user-dirs-update --set PUBLICSHARE "$HOME"
xdg-user-dirs-update --set DESKTOP "$HOME"
# Name the rest now, so a first login in another language does not create
# translated folders beside the English ones os made and bookmarked. A
# folder the user already named, in any language, stays theirs.
for dir in DOWNLOAD:Downloads PICTURES:Pictures VIDEOS:Videos DOCUMENTS:Documents MUSIC:Music; do
  # Created too: xdg-user-dirs resets a named folder that does not exist.
  grep -q "^XDG_${dir%%:*}_DIR=" "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" 2>/dev/null ||
    { mkdir -p "$HOME/${dir#*:}" && xdg-user-dirs-update --set "${dir%%:*}" "$HOME/${dir#*:}"; }
done
rmdir ~/Templates ~/Public ~/Desktop 2>/dev/null || true
touch ~/.config/gtk-3.0/bookmarks
for dir in Downloads Projects Pictures Videos; do
  bookmark="file://$HOME/$dir $dir"
  grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
done

run_logged "$ARCH_PATH/src/python/installer_user/all.py"

arch-refresh-applications
env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser chromium.desktop
xdg-mime default HEY.desktop x-scheme-handler/mailto

if (( first_install )); then
  mkdir -p "$state_dir/migrations"
  for migration in "$ARCH_PATH"/migrations/*.sh; do
    [[ -f $migration ]] && touch "$state_dir/migrations/$(basename "$migration")"
  done
fi

arch-done mark finalize-user
echo "User finalization complete."
