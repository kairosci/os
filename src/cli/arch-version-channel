#!/bin/bash

# arch:summary=Print the active Arch mirror and package channel

# Arch Linux ARM's mirrors are the same hosts with an arm- prefix.
if grep -Eq "https://(arm-)?stable-mirror\.github\.com/kairosci/arch/" /etc/pacman.d/mirrorlist; then
  mirror="stable"
elif grep -Eq "https://(arm-)?rc-mirror\.github\.com/kairosci/arch/" /etc/pacman.d/mirrorlist; then
  mirror="rc"
elif grep -Eq "https://(arm-)?mirror\.github\.com/kairosci/arch/" /etc/pacman.d/mirrorlist; then
  mirror="edge"
else
  mirror="unknown"
fi

if grep -q "https://pkgs.github.com/kairosci/arch/stable/" /etc/pacman.conf; then
  pkgs="stable"
elif grep -q "https://pkgs.github.com/kairosci/arch/rc/" /etc/pacman.conf; then
  pkgs="rc"
elif grep -q "https://pkgs.github.com/kairosci/arch/edge/" /etc/pacman.conf; then
  pkgs="edge"
else
  pkgs="unknown"
fi

if [[ $mirror == $pkgs ]]; then
  echo $mirror
else
  echo "$mirror / $pkgs"
fi
