#!/bin/bash

# arch:summary=Apply Arch system setup in the installed target
# arch:group=apply
# arch:requires-sudo=true
# arch:examples=arch apply system --install-user dhh --first-install
# arch:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: arch apply system --install-user USER [--first-install|--upgrade]
       arch apply system --defer-provisioning --first-install

Runs root-owned os system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
arch-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/arch/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${ARCH_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: arch-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export ARCH_INSTALL_USER="$install_user"
export ARCH_FIRST_INSTALL="$first_install"
export ARCH_UPGRADE="$upgrade"
export ARCH_PATH="${ARCH_PATH:-/usr/share/arch}"
export ARCH_INSTALL="${ARCH_INSTALL:-$ARCH_PATH/installer}"
export ARCH_INSTALL_LOG_FILE="${ARCH_INSTALL_LOG_FILE:-/var/log/arch-install.log}"
export PATH="$ARCH_PATH/src/cli:$PATH"

source "$ARCH_INSTALL/helpers/logging.sh"
start_install_log

run_logged "$ARCH_PATH/src/python/installer/system_setup/all.py"

if (( defer_provisioning )); then
  arch-apply-hardware --defer-provisioning
else
  arch-apply-hardware --install-user "$install_user"
fi

run_logged "$ARCH_PATH/src/python/installer/login/sddm.py"
run_logged "$ARCH_PATH/src/python/installer/post_install/all.py"

stop_install_log
