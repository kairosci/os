#!/bin/bash

# arch:summary=Remove Grok Bot along with its settings and data.
# arch:requires-sudo=true

set -e

arch-pkg-drop grok-bot

# Not ~/.grok: that is the Grok CLI, which is installed and used on its own.
rm -rf \
  "$HOME/.config/Grok Bot" \
  "$HOME/.grokbot"

echo ""
echo "Grok Bot has been removed."
