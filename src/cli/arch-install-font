#!/bin/bash

# arch:summary=Install a preferred monospace font package and switch the system to it
# arch:args=[<display-name> <package> <family>]
# arch:examples=archctl install font

if [[ ${1-} == --apply ]]; then
  package=${2-}
  family=${3-}
  package_re='^[A-Za-z0-9._+-]+$'
  family_re='^[[:alnum:]_. -]+$'
  [[ $# == 3 && $package =~ $package_re && $family =~ $family_re ]] || {
    echo "Usage: arch-install-font --apply <package> <font-family>" >&2
    exit 2
  }
  arch-pkg-add "$package" && fc-cache -f >/dev/null && arch-font-set "$family"
  exit $?
fi

if (( $# == 3 )); then
  name=$1
  package=$2
  family=$3
  printf -v install_message '%q' "Installing ${name}..."
  printf -v package_arg '%q' "$package"
  printf -v family_arg '%q' "$family"
  exec arch-launch-floating-terminal-with-presentation \
    "echo ${install_message}; arch-pkg-add ${package_arg} && sleep 2 && arch-font-set ${family_arg}"
fi

if (( $# != 0 )); then
  echo "Usage: arch-install-font" >&2
  exit 2
fi

exec arch-launch-floating-terminal-with-presentation \
  'read -r -p "Arch package name: " package; read -r -p "Font family name (as shown by fc-list): " family; if [[ $package =~ ^[A-Za-z0-9._+-]+$ && -n $family ]]; then arch-install-font --apply "$package" "$family"; else echo "Invalid package or font family"; fi; read -r -p "Press Enter to close" _'
