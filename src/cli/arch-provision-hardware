#!/bin/bash

# arch:summary=Finish the hardware setup an image build deferred to this machine
# arch:requires-sudo=true
# arch:hidden=true

# Started by arch-provision-hardware.service on every boot while an image's
# deferred steps remain (see installer/helpers/image-target.sh), and safe to call
# from a platform's own first boot as well: runs are serialised. The first run
# retires the image's build manifest, so from then on this machine is itself.
# Steps run in order and each one that succeeds leaves the queue, so a failure
# stops the run and the next run resumes at that step. Once the queue is empty
# the initramfs is rebuilt if any step changed its configuration or asked for
# the rebuild, and the service is disabled. With nothing deferred this does
# nothing. A failed step, or a failure to make the pacman keyring the build
# asked for, exits 75 (it stays queued for the next run); anything else that
# stops the run, such as an untrusted manifest or queue, exits 1.

set -euo pipefail

fail() {
  echo "Error: $*" >&2
  exit 1
}

if (( EUID == 0 )); then
  export ARCH_PATH=/usr/share/arch
  export PATH=/usr/share/arch/src/cli:/usr/local/sbin:/usr/local/bin:/usr/bin
elif [[ -z ${ARCH_IMAGE_ROOT:-} || -z ${ARCH_PATH:-} ]]; then
  fail "arch-provision-hardware must run as root"
fi
export ARCH_INSTALL=$ARCH_PATH/installer
export ARCH_INSTALL_USER=""

source "$ARCH_INSTALL/helpers/logging.sh"
source "$ARCH_INSTALL/helpers/image-target.sh"
arch_image_init
export ARCH_INSTALL_LOG_FILE=$arch_image_root/var/log/arch-install.log

queue_present() {
  [[ -e $arch_image_queue || -L $arch_image_queue ]]
}

# Anything left for the first boot: the manifest, a queue, or the keyring an
# image build asked for, which is owed even when no step was queued.
work_present() {
  arch_image_manifest_present || queue_present || [[ -e $arch_image_keyring_request ]]
}

work_present || exit 0
arch_image_lock || exit 1
# Another run may have finished while this one waited for the lock.
work_present || exit 0

if arch_image_manifest_present; then
  arch_image_read_manifest || exit 1
  mv -f "$arch_image_manifest" "$arch_image_manifest.booted" || fail "could not retire $arch_image_manifest"
  live_platform=$(arch-hw-platform) || live_platform=unknown
  echo "First boot of an image built for $arch_image_platform, on $live_platform hardware"
fi

remaining=()
if queue_present; then
  [[ -f $arch_image_queue ]] && arch_image_trusted "$arch_image_queue" ||
    fail "$arch_image_queue is not a root-owned regular file"
  mapfile -t queued <"$arch_image_queue"
  for step in "${queued[@]}"; do
    [[ -z $step ]] || remaining+=("$step")
  done
fi

# What the boot image is built from: mkinitcpio's configuration, the module
# options its modconf hook copies in (leaves such as nvidia.sh write them), and
# the kernel command line Limine's entry tool adds (leaves such as intel/fred.sh
# add to it).
initramfs_inputs() {
  local file

  for file in "$arch_image_root/etc/mkinitcpio.conf" "$arch_image_root/etc/mkinitcpio.conf.d/"* \
    "$arch_image_root/etc/modprobe.d/"* "$arch_image_root/usr/lib/modprobe.d/"* \
    "$arch_image_root/etc/default/limine" "$arch_image_root/etc/limine-entry-tool.d/"*; do
    [[ -e $file ]] || continue
    printf '%s\0' "$file"
    cat -- "$file"
  done | cksum
}

# Recorded before the first step and kept until a rebuild lands, so a step that
# changed the initramfs and then failed or lost power still gets one.
if [[ ! -f $arch_image_initramfs_baseline ]]; then
  baseline=$(mktemp "$arch_image_dir/.initramfs-inputs.XXXXXX") &&
    initramfs_inputs >"$baseline" && chmod 0644 "$baseline" && mv -f "$baseline" "$arch_image_initramfs_baseline" ||
    fail "could not record the initramfs inputs"
fi

mkdir -p "$(dirname "$ARCH_INSTALL_LOG_FILE")"

# A step that would build the boot image itself (a platform's boot setup) asks
# for this run's rebuild instead, so the image is built once, after the last
# step. The request stays on disk until that rebuild lands.
export ARCH_IMAGE_BOOT_REBUILD=$arch_image_boot_rebuild
# Tells a step it runs on the booted machine, after boot already brought up the
# targets its units hang off (see src/python/installer/hardware/bluetooth.py).
export ARCH_IMAGE_DEFERRED_HARDWARE=1

# An image build asks for this machine's own pacman keyring (see
# src/python/installer/post_install/pacman.py), made before any step installs a package. Any
# keyring the build or an interrupted run left is replaced; the request stays
# until a keyring is complete.
if [[ -e $arch_image_keyring_request ]]; then
  echo "Creating this machine's pacman keyring"
  keyring=$arch_image_root/etc/pacman.d/gnupg
  if ! { rm -rf "$keyring" && pacman-key --gpgdir "$keyring" --init &&
    pacman-key --gpgdir "$keyring" --populate; } </dev/null >>"$ARCH_INSTALL_LOG_FILE" 2>&1; then
    echo "Error: could not create the pacman keyring (see $ARCH_INSTALL_LOG_FILE); the next run retries it" >&2
    exit 75
  fi
  rm -f "$arch_image_keyring_request"
fi

while (( ${#remaining[@]} )); do
  step=${remaining[0]}
  if [[ $step != installer/hardware/*.sh || $step == *..* ]]; then
    [[ $step == src/python/installer/hardware/*.py && $step != *..* ]] ||
      fail "Deferred step is not a hardware setup step: $step"
  fi
  script=$ARCH_PATH/$step

  if [[ -L $script ]]; then
    fail "Deferred step is a symlink: $step"
  elif [[ ! -e $script ]]; then
    echo "Skipping deferred hardware step $step: this os no longer ships it"
  else
    echo "Running deferred hardware step $step"
    if ! run_logged "$script"; then
      echo "Error: Deferred hardware step failed: $step (see $ARCH_INSTALL_LOG_FILE); the next run resumes here" >&2
      exit 75
    fi
  fi

  remaining=("${remaining[@]:1}")
  arch_image_write_queue "${remaining[@]}" || fail "could not update $arch_image_queue"
done

if [[ -e $arch_image_boot_rebuild || $(initramfs_inputs) != "$(<"$arch_image_initramfs_baseline")" ]]; then
  echo "Rebuilding the initramfs for the deferred hardware setup"
  arch-kernel-rebuild </dev/null >>"$ARCH_INSTALL_LOG_FILE" 2>&1 ||
    fail "Initramfs rebuild failed (see $ARCH_INSTALL_LOG_FILE); the next run retries it"
  # The new image must be on disk before the queue that owes it is cleared.
  sync || fail "could not flush the rebuilt initramfs to disk"
fi
rm -f "$arch_image_initramfs_baseline" "$arch_image_boot_rebuild"

# Disabled, not deleted: a platform first boot that runs this while the
# service's start job waits would otherwise fail that job at the next
# daemon-reload. The emptied queue keeps the unit from running.
rm -f "$arch_image_systemd_dir/multi-user.target.wants/$arch_image_unit"
rm -f "$arch_image_queue"
if (( EUID == 0 )); then
  systemctl daemon-reload 2>/dev/null || true
fi
echo "Deferred hardware setup is complete"
