#!/bin/bash

# arch:summary=Forget an added Claude or Codex account
# arch:args=[claude|codex] <account>
# arch:examples=archctl agent account remove work | archctl agent account remove codex side

set -uo pipefail

# The provider can be left out when it's your default agent:
# `archctl agent account use work`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" ]]; then
  default=$(arch-default-agent)
  [[ $default == "claude" || $default == "codex" ]] && set -- "$default" "$@"
fi

if [[ ${1:-} != "claude" && ${1:-} != "codex" ]] || [[ -z ${2:-} ]]; then
  echo "Usage: arch-agent-account-remove [claude|codex] <account>" >&2
  exit 1
fi

# Removing only deletes the account's home here. It never logs out, which
# would revoke the sign-in for every other copy of it too.
if [[ -t 0 ]] && ! gum confirm "Forget the $1 account $2? You'd have to sign in again to add it back."; then
  exit 130
fi

account=$(arch-agent-account-state remove "$1" "$2") || exit 1
echo "Forgot $(jq -r .label <<<"$account")."
# The panel reads which accounts exist from the usage record.
arch-agent-usage-update --limits-only "$1" >/dev/null 2>&1 &
