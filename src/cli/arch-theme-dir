#!/bin/bash

# arch:summary=Print the directory holding a theme, preferring a user-installed copy
# arch:args=<theme-name>
# arch:examples=archctl theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: arch-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/arch/themes/$theme ]]; then
  echo "$HOME/.config/arch/themes/$theme"
else
  echo "$ARCH_PATH/assets/themes/$theme"
fi
