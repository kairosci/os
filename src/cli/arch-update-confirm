#!/bin/bash

# arch:summary=Prompt for confirmation before starting an update

gum style --border normal --padding "1 2" \
  "$(arch-i18n update.ready)" \
  "" \
  "• $(arch-i18n update.cannotStop)" \
  "• $(arch-i18n update.connectPower)" \
  "" \
  "$(arch-i18n update.whatsNew "https://github.com/kairosci/os")"

echo

if ! gum confirm --affirmative "$(arch-i18n common.yes)" --negative "$(arch-i18n common.no)" "$(arch-i18n update.continue)"; then
  echo "Update cancelled"
  exit 1
fi
