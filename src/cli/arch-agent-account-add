#!/bin/bash

# arch:summary=Sign in to a Claude or Codex subscription
# arch:args=[--check] [--events] [--reauth <account>] [claude|codex] [label]
# arch:examples=archctl agent account add claude | archctl agent account add Work | archctl agent account add codex Side

set -uo pipefail

# --check prints, per provider, whether adding one now would be its first
# sign-in, an additional account, or not possible yet. --events is for the
# agents panel: progress arrives as `@@arch <event> <detail>` lines mixed
# into the CLI's own output (which carries codes the panel shows), nothing
# waits on a terminal, and the result also lands as a notification in case
# the panel has closed.
# --reauth <account> signs an account that's already here in again, in its
# own home, for when its sign-in has lapsed.
check=false
events=false
reauth=""
while [[ ${1:-} == --* ]]; do
  case "$1" in
  --check) check=true ;;
  --events) events=true ;;
  --reauth)
    reauth="${2:-}"
    shift
    ;;
  *) break ;;
  esac
  shift
done

# Whether a provider's own home (~/.claude or ~/.codex) is signed in.
primary_signed_in() {
  arch-agent-account-state list "$1" | jq -e '.[0].accounts | any(.primary and .signedIn)' >/dev/null
}

if [[ $check == "true" ]]; then
  for p in claude codex; do
    if primary_signed_in "$p"; then
      echo "$p additional"
    else
      echo "$p first"
    fi
  done
  exit 0
fi

# The provider can be left out when it's your default agent:
# `archctl agent account add Work`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" ]]; then
  default=$(arch-default-agent)
  [[ $default == "claude" || $default == "codex" ]] && set -- "$default" "$@"
fi

case "${1:-}" in
claude) provider="claude"; name="Claude"; site="claude.ai"; package="claude"; home_env="CLAUDE_CONFIG_DIR" ;;
codex) provider="codex"; name="Codex"; site="chatgpt.com"; package="codex"; home_env="CODEX_HOME" ;;
*)
  echo "Usage: arch-agent-account-add [--check] [--events] [--reauth <account>] [claude|codex] [label]" >&2
  exit 1
  ;;
esac
label="${2:-}"

say() {
  if [[ $events == "true" ]]; then
    printf '@@archctl status %s\n' "$*"
  else
    echo "$*"
  fi
}

finish() {
  if [[ $events == "true" ]]; then
    printf '@@arch done %s\n' "$1"
    arch-notification-send -g 󰚩 "$1"
  else
    echo
    echo "$1"
  fi
}

fail() {
  if [[ $events == "true" ]]; then
    printf '@@arch error %s\n' "$1"
    arch-notification-send -g 󰚩 -u critical "$(arch-i18n agents.addFailed "$name")" "$1"
  else
    echo "$1" >&2
  fi
  exit 1
}

# Cancelling from the panel stops the CLI's login too, and leaves no
# half-made home behind.
home=""
browser=""
cleanup() {
  [[ -n $browser ]] && rm -f "$browser"
  [[ -n $home && -d $home && $home == */.pending/* ]] && rm -rf "$home"
}
trap cleanup EXIT
trap 'pkill -TERM -P $$; exit 130' TERM INT

# Bash holds a trap until a foreground command finishes, and a login waits on
# the browser for as long as it takes. Running it in the background behind a
# `wait` lets Cancel stop it at once. It keeps this script's stdin, where the
# panel sends a pasted code.
interruptible() {
  "$@" <&0 &
  wait $!
}

if arch-cmd-missing "$provider"; then
  say "$(arch-i18n agents.installingCli "$name")"
  if [[ $events == "true" ]]; then
    mise use -g "$package" >/dev/null 2>&1 || fail "$(arch-i18n agents.installCliFailed "$name")"
  else
    mise use -g "$package" || exit 1
  fi
fi

# Your main browser is almost certainly signed in to the account you already
# have, and a login would quietly reuse it. The CLIs open their login page
# through $BROWSER, so this points it at a private window instead.
private_browser() {
  browser=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/arch-account-browser.XXXXXX") || fail "$(arch-i18n agents.homeFailed)"
  printf '#!/bin/bash\nexec arch-launch-browser --private "$1"\n' >"$browser" || fail "$(arch-i18n agents.homeFailed)"
  chmod +x "$browser" || fail "$(arch-i18n agents.homeFailed)"
}

case "$provider" in
claude) login_command=(claude auth login) ;;
codex) login_command=(codex login) ;;
esac

# The CLI's own home, whatever this shell has pointed it at.
login() {
  interruptible env -u CLAUDE_CONFIG_DIR -u CODEX_HOME "ARCH_AGENT_${provider^^}_HOME=" "${login_command[@]}"
}

# Signing an account that's already here in again, where it lives: the
# primary home through the normal browser, an added one through a private
# window. Its home is never recreated or removed.
if [[ -n $reauth ]]; then
  if [[ $reauth == ":primary" ]]; then
    account_home="$HOME/.$provider"
  else
    account_home=$(arch-agent-account-state homes "$provider" | awk -F'\t' -v id="$reauth" '$1 == id { print $2 }')
  fi
  [[ -n $account_home ]] || fail "$(arch-i18n agents.noAccountNamed "$name" "$reauth")"

  if [[ $account_home == "$HOME/.$provider" ]]; then
    say "$(arch-i18n agents.signInAgainBrowser "$name")"
    login || fail "$(arch-i18n agents.signInFailed "$name")"
  else
    say "$(arch-i18n agents.signInAgainPrivate)"
    private_browser
    interruptible env BROWSER="$browser" "$home_env=$account_home" "${login_command[@]}" || fail "$(arch-i18n agents.signInFailed "$name")"
  fi

  arch-agent-usage-update --force "$provider" >/dev/null 2>&1 &
  finish "$(arch-i18n agents.signedInAgain "$name")"
  exit 0
fi

# The first subscription signs in where the CLI always looks, through your
# normal browser: nothing is signed in there yet that it could be mistaken for.
if ! primary_signed_in "$provider"; then
  say "$(arch-i18n agents.signInBrowser "$name")"
  if login && primary_signed_in "$provider"; then
    # The first agent signed in on a machine with none chosen becomes the
    # default, so `archctl agent` and the panel's starter prompts have one to
    # run. A default someone already picked is never touched.
    if [[ -z $(arch-default-agent) ]]; then
      mkdir -p "$HOME/.config/arch/defaults"
      printf '%s\n' "$provider" >"$HOME/.config/arch/defaults/agent"
    fi
    arch-agent-usage-update --force "$provider" >/dev/null 2>&1 &
    finish "$(arch-i18n agents.signedIn "$name")"
  else
    fail "$(arch-i18n agents.signInFailed "$name")"
  fi
else
  # Retry the final registration of a completed, interrupted sign-in before
  # asking for another browser login. Live sign-ins are never recovered.
  if recovered=$(arch-agent-account-state recover "$provider"); then
    if [[ $(jq 'length' <<<"$recovered") != "0" ]]; then
      added=$(jq -r 'map(.label + (if .email != "" then " (" + .email + ")" else "" end)) | join(", ")' <<<"$recovered")
      arch-agent-usage-update --force "$provider" >/dev/null 2>&1 &
      finish "$(arch-i18n agents.added "$added")"
      exit 0
    fi
  else
    fail "$recovered"
  fi

  if [[ -z $label && $events == "false" && -t 0 ]]; then
    label=$(gum input --placeholder "Work" --prompt "Name this $name account: ") || exit 130
  fi

  if [[ $events == "true" ]]; then
    say "$(arch-i18n agents.signInPrivate)"
  else
    cat <<EOF

Sign in as the account you're adding in the private window that opens.
If a private window was already open, close it first, or $site may reuse whoever it has signed in.

Don't log out of the $name CLI to do this: logging out revokes the saved sign-in.

EOF
  fi

  home=$(arch-agent-account-state begin "$provider" "$label" "$$") || fail "$(arch-i18n agents.homeFailed)"

  private_browser
  interruptible env BROWSER="$browser" "$home_env=$home" "${login_command[@]}"

  if account=$(arch-agent-account-state register "$provider" "$label" "$home" 2>&1); then
    home=""
    added=$(jq -r '.label + (if .email != "" then " (" + .email + ")" else "" end)' <<<"$account")
    arch-agent-usage-update --force "$provider" >/dev/null 2>&1 &
    if [[ $events == "true" ]]; then
      finish "$(arch-i18n agents.added "$added")"
    else
      finish "$(arch-i18n agents.added "$added")"
      echo "Switch to it with: archctl agent account use $provider $(jq -r .id <<<"$account")"
    fi
  else
    registration_status=$?
    # Keep the home for cleanup when registration was explicitly interrupted.
    # Storage failures preserve the sign-in and receipt for the next refresh.
    if (( registration_status != 130 )); then
      home=""
    fi
    fail "$account"
  fi
fi
