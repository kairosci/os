#!/bin/bash

# arch:summary=Refresh the current theme from its templates.

THEME_NAME_PATH="$HOME/.local/state/arch/current/theme.name"

# Installers refresh the theme and then read the app configs it
# writes, so this waits for every retint rather than leaving some running.
if [[ -f $THEME_NAME_PATH ]]; then
  ARCH_THEME_WAIT=1 ARCH_THEME_SKIP_BACKGROUND=1 arch-theme-set "$(cat $THEME_NAME_PATH)"
fi
