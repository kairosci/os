#!/bin/bash

# arch:summary=Launch the default coding agent in a terminal
# arch:args=[--inline] [--pick]
# arch:examples=archctl agent | archctl agent --inline

inline=false

# Flags only. A bare prompt would shadow the subcommands under this group, so
# prompts go through arch-agent-prompt, which passes one here as --prompt.
while (($#)); do
  case "$1" in
    --inline)
      inline=true
      shift
      ;;
    --prompt)
      prompt=${2:?--prompt needs a value}
      shift 2
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      echo "To pass a prompt: archctl agent prompt \"$*\"" >&2
      exit 1
      ;;
  esac
done

# Agents refuse to remember trust for $HOME, so launches from the keybinding or
# menu start in the work directory instead of re-asking on every session.
[[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"

agent=$(arch-default-agent)

# The user chooses a default explicitly before the launcher can run.
if [[ -z $agent ]]; then
  echo "Choose default agent with: archctl default agent <name>" >&2
  exit 1
fi

# Only the two supported coding tools can be selected as the default.
if [[ $agent != "claude" && $agent != "codex" ]]; then
  echo "Unsupported default agent: $agent" >&2
  exit 1
fi

if arch-cmd-missing "$agent"; then
  echo "$agent is not installed. Choose an installed agent with: archctl default agent <name>" >&2
  exit 1
fi

case "$agent" in
claude)
  command=(claude)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
codex)
  command=(codex)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
*)
  echo "Unsupported default agent: $agent" >&2
  exit 1
  ;;
esac

# A new session uses the current selection rather than its parent's account
# pin. Explicit provider homes still override the selection. Carry the new pin
# in the command, since terminals launched through uwsm don't inherit our env.
case "$agent" in
claude) home_env="CLAUDE_CONFIG_DIR" ;;
codex) home_env="CODEX_HOME" ;;
esac
account_pin="ARCH_AGENT_${agent^^}_HOME"
if [[ -v $account_pin && ${!home_env:-} == "${!account_pin}" ]]; then
  unset "$home_env"
fi
unset "$account_pin"
if [[ -z ${!home_env:-} ]]; then
  home=$(arch-agent-account-home "$agent")
  account_env=(env -u "$home_env" "$account_pin=$home")
  [[ -n $home ]] && account_env+=("$home_env=$home")
  command=("${account_env[@]}" "${command[@]}")
fi

if [[ $inline == "true" ]]; then
  exec "${command[@]}"
else
  # A fixed app-id rather than the default org.arch.<binary>, so every agent
  # window shares one class for window rules and themes to single out.
  exec arch-launch-tui --app-id=org.arch.agent "${command[@]}"
fi
