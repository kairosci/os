#!/bin/bash

# arch:summary=Launch the default coding agent in a terminal
# arch:args=[--inline] [--pick]
# arch:examples=archctl agent | archctl agent --inline

inline=false
pick=false

# Flags only. A bare prompt would shadow the subcommands under this group, so
# prompts go through arch-agent-prompt, which passes one here as --prompt.
while (($#)); do
  case "$1" in
    --inline)
      inline=true
      shift
      ;;
    --pick)
      pick=true
      shift
      ;;
    --prompt)
      prompt=${2:?--prompt needs a value}
      shift 2
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      echo "To pass a prompt: archctl agent prompt \"$*\"" >&2
      exit 1
      ;;
  esac
done

# Agents refuse to remember trust for $HOME, so launches from the keybinding or
# menu start in the work directory instead of re-asking on every session.
[[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"

agent=$(arch-default-agent)

# os ships without a default, so there is nothing to launch until one is
# picked. --pick offers the choice instead of the error, which is what the
# keybinding wants: a keypress that opens nothing explains nothing.
if [[ -z $agent ]]; then
  [[ $pick == "true" ]] && exec arch-menu summon setup.default.agent
  echo "Choose default agent with: archctl default agent <name>" >&2
  exit 1
fi

# OpenClaw's launcher sets OpenClaw up when the package became the seed before
# this user's OpenClaw moved, so with the package a missing command is its to fix.
if arch-cmd-missing "$agent" && ! { [[ $agent == "openclaw" ]] && arch-pkg-present openclaw; }; then
  echo "$agent is not installed. Choose an installed agent with: archctl default agent <name>" >&2
  exit 1
fi

# Use each provider's default permission handling so requests for tool access
# remain visible to the user.
case "$agent" in
opencode)
  command=(opencode)
  [[ -n ${prompt:-} ]] && command+=(--prompt "$prompt")
  ;;
agy)
  command=(agy)
  [[ -n ${prompt:-} ]] && command+=(--prompt-interactive "$prompt")
  ;;
copilot)
  command=(copilot)
  [[ -n ${prompt:-} ]] && command+=(--interactive "$prompt")
  ;;
crush)
  # Keep Crush in its interactive mode so tool permissions remain visible.
  command=(crush)
  ;;
claude)
  command=(claude)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
grok)
  command=(grok)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
openclaw)
  # The launcher owns onboarding and the gateway dance: OpenClaw's terminal UI
  # must attach to the running gateway (the embedded `openclaw chat` refuses to
  # start while the gateway owns the state directory). It has no permission
  # prompts to skip, and --message seeds the session while keeping it
  # interactive.
  command=(arch-launch-openclaw --tui)
  [[ -n ${prompt:-} ]] && command+=(--message "$prompt")
  ;;
codex)
  command=(codex)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
cursor-agent)
  # Start the interactive agent without accepting workspace trust implicitly.
  command=(cursor-agent agent)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
hermes)
  if [[ -n ${prompt:-} ]]; then
    command=(env -u HERMES_SESSION_SOURCE hermes chat --tui "--query=$prompt")
  else
    command=(hermes)
  fi
  ;;
muse)
  command=(muse)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
omp)
  command=(omp)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
ori)
  # Ori is a harness launcher, and `ori code` is the agent it runs itself.
  # A prompt alone means one headless turn there, printed after the turn ends,
  # so --interactive is what seeds the session with it and keeps the window.
  command=(ori code)
  [[ -n ${prompt:-} ]] && command+=(--interactive --prompt "$prompt")
  ;;
pi)
  command=(pi)
  [[ -n ${prompt:-} ]] && command+=("$prompt")
  ;;
kimi)
  # Keep Kimi's prompt mode under its default permission handling.
  if [[ -n ${prompt:-} ]]; then
    command=(kimi --prompt "$prompt")
  else
    command=(kimi)
  fi
  ;;
*)
  echo "Unsupported default agent: $agent" >&2
  exit 1
  ;;
esac

# A user-installed Cursor or Muse still wins in the agent launcher even when
# mise's system lazy shim is earlier on PATH.
if [[ $agent == "cursor-agent" || $agent == "muse" ]] &&
  [[ -f $HOME/.local/bin/$agent && -x $HOME/.local/bin/$agent ]] &&
  { [[ -L $HOME/.local/bin/$agent ]] || ! grep -q '^mise use -g' "$HOME/.local/bin/$agent"; }; then
  command[0]="$HOME/.local/bin/$agent"
fi

# A new session uses the current selection rather than its parent's account
# pin. Explicit provider homes still override the selection. Carry the new pin
# in the command, since terminals launched through uwsm don't inherit our env.
case "$agent" in
claude) home_env="CLAUDE_CONFIG_DIR" ;;
codex) home_env="CODEX_HOME" ;;
grok) home_env="GROK_HOME" ;;
*) home_env="" ;;
esac
if [[ -n $home_env ]]; then
  account_pin="ARCH_AGENT_${agent^^}_HOME"
  if [[ -v $account_pin && ${!home_env:-} == "${!account_pin}" ]]; then
    unset "$home_env"
  fi
  unset "$account_pin"
  if [[ -z ${!home_env:-} ]]; then
    home=$(arch-agent-account-home "$agent")
    account_env=(env -u "$home_env" "$account_pin=$home")
    [[ -n $home ]] && account_env+=("$home_env=$home")
    command=("${account_env[@]}" "${command[@]}")
  fi
fi

if [[ $inline == "true" ]]; then
  exec "${command[@]}"
else
  # A fixed app-id rather than the default org.arch.<binary>, so every agent
  # window shares one class for window rules and themes to single out.
  exec arch-launch-tui --app-id=org.arch.agent "${command[@]}"
fi
