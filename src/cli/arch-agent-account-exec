#!/bin/bash

# arch:summary=Run Claude or Codex as the selected subscription account
# arch:args=<claude|codex> [args...]
# arch:hidden=true

set -euo pipefail

case "${1:-}" in
  claude) account_env="CLAUDE_CONFIG_DIR" ;;
  codex) account_env="CODEX_HOME" ;;
  *)
    echo "Usage: arch-agent-account-exec <claude|codex> [args...]" >&2
    exit 1
    ;;
esac

provider=$1
shift

# mise removes its wrapper dispatch directories before calling us, so exec
# finds the real CLI (or its first-run installer) rather than this wrapper.
# Pin the resolved home for children, including an implicit Main account.
# Explicit provider homes still take precedence.
if [[ -z ${!account_env:-} ]]; then
  account_home=$(arch-agent-account-home "$provider")
  export "ARCH_AGENT_${provider^^}_HOME=$account_home"
  if [[ -n $account_home ]]; then
    export "$account_env=$account_home"
  fi
fi

# Resolve the selected CLI from the normal PATH, keeping account selection
# separate from executable lookup.
if ! agent_binary=$(type -P "$provider"); then
  # A mise dispatcher can exist before its CLI or first-run installer does.
  # os declares these agents, so installing one leaves the user's config
  # alone. A user who removed the preinstalls selects it in their own config.
  export MISE_MINIMUM_RELEASE_AGE=0
  if arch-mise-default-tools declares "$provider"; then
    mise install --quiet "$provider"
  else
    mise use -g --quiet "$provider"
  fi
  agent_binary=$(mise which "$provider")
fi
exec "$agent_binary" "$@"
