#!/bin/bash

# arch:summary=Choose which Claude or Codex account new sessions use
# arch:args=[claude|codex] [account|next]
# arch:examples=archctl agent account use work | archctl agent account use main | archctl agent account use codex next

set -uo pipefail

# The provider can be left out when it's your default agent:
# `archctl agent account use work`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" ]]; then
  default=$(arch-default-agent)
  [[ $default == "claude" || $default == "codex" ]] && set -- "$default" "$@"
fi

case "${1:-}" in
claude) name="Claude" ;;
codex) name="Codex" ;;
*)
  echo "Usage: arch-agent-account-use [claude|codex] [account|next]" >&2
  exit 1
  ;;
esac

result=$(arch-agent-account-state use "$1" "${2:-next}") || exit 1

previous=$(jq -r .previous.label <<<"$result")
active=$(jq -r '.active.label + (if (.active.plan // "") != "" then " (" + .active.plan + ")" else "" end)' <<<"$result")
label=$(jq -r .active.label <<<"$result")

if [[ $(jq -r .previous.id <<<"$result") == "$(jq -r .active.id <<<"$result")" ]]; then
  echo "New $name sessions already use $active."
else
  message="Running sessions stay on $previous."
  echo "New $name sessions now use $active. $message"
  # The headline leaves out the plan, so it stays on one line.
  arch-notification-send -g 󰚩 "$(arch-i18n agents.newSessionsUse "$name" "$label")" "$(arch-i18n agents.runningStayOn "$previous")"
  # The usage record's own limits describe the active account.
  arch-agent-usage-update --limits-only "$1" >/dev/null 2>&1 &
fi
