#!/bin/bash

# arch:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# arch:group=remove
# arch:name=gaming xbox-controllers
# arch:requires-sudo=true

set -e

arch-pkg-drop xpadneo-dkms

sudo rm -f /etc/modprobe.d/blacklist-xpad.conf /etc/modules-load.d/xpadneo.conf

echo ""
echo "Xbox controller support removed. Reboot to fully unload xpadneo and restore xpad."
