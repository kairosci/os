#!/bin/bash

# arch:summary=Show idle, screensaver, and lock diagnostics
# arch:group=debug
# arch:args=[log-lines]
# arch:examples=archctl debug idle | arch-debug-idle 400

lines=${1:-200}
if [[ ! $lines =~ ^[0-9]+$ ]]; then
  lines=200
fi

section() {
  printf '\n== %s ==\n' "$1"
}

section "Time"
date -Is

section "Idle IPC status"
arch-shell idle status 2>&1 | jq . 2>/dev/null || arch-shell idle status 2>&1 || true

section "Quickshell instances"
quickshell list -p "$ARCH_PATH/src/shell" --any-display 2>&1 || true

section "Recent idle logs"
quickshell --no-color log -p "$ARCH_PATH/src/shell" --any-display --tail "$lines" --log-times -r 'quickshell.wayland.idle_notify=true' 2>&1 \
  | grep -Ei 'arch idle|idle_notify|screensaver|lock|error|warn|failed' || true

section "Persisted shell log"
journalctl -t arch-shell -n "$lines" --no-pager --quiet 2>/dev/null || true

section "Relevant processes"
ps -eo pid=,args= \
  | grep -E 'quickshell -n -p|arch-system-sleep-monitor|systemd-inhibit.*Lock screen before suspend|org\.arch\.screensaver|arch-screensaver|(^|/| )ttfx( |$)' \
  | grep -v grep || true

section "Sleep lock service"
systemctl --user status arch-sleep-lock.service --no-pager 2>/dev/null || true

section "Hyprland screensaver clients"
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.class == "org.arch.screensaver" or .initialClass == "org.arch.screensaver") | [.pid,.class,.initialClass,.title,.focusHistoryID] | @tsv' || true

section "Idle inhibitors"
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.inhibitingIdle == true or ((.tags // []) | index("noidle"))) | [.pid,.class,.title,((.tags // []) | join(",")),.inhibitingIdle] | @tsv' || true

section "Screensaver detector"
if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "org.arch.screensaver" or .initialClass == "org.arch.screensaver")' >/dev/null; then
  echo "running-window"
elif pgrep -f '[o]rg.arch.screensaver' >/dev/null; then
  echo "running-process"
elif arch-toggle-enabled screensaver-off; then
  echo "disabled"
else
  echo "stopped"
fi

section "Lock detector"
arch-shell lock status 2>&1 | jq . 2>/dev/null || arch-shell lock status 2>&1 || true
