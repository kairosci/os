#!/bin/bash

# arch:summary=Install Emacs with Arch theme and font integration via the arch-emacs AUR package

echo "Installing Emacs..."
arch-pkg-aur-add arch-emacs && arch-install-emacs

# emacsclient opens a frame on the running daemon, not a second Emacs
setsid uwsm-app -- gtk-launch emacsclient >/dev/null 2>&1 &
