#!/bin/bash

# arch:summary=Remove preinstalled Arch applications (web apps, TUIs, and selected packages).

if gum confirm --affirmative "$(arch-i18n common.yes)" --negative "$(arch-i18n common.no)" "$(arch-i18n preinstalls.confirmRemove)"; then
  echo -e "Removing preinstalled os applications...\n"

  arch-webapp-remove-all
  arch-tui-remove-all

  mkdir -p ~/.local/state/arch
  touch ~/.local/state/arch/preinstalls-removed
  hyprctl reload

  # Disable os's default mise tools for this user and retire their shims.
  arch-mise-default-tools disable || exit 1

  arch-pkg-drop \
    aether \
    cliamp \
    libreoffice-fresh \
    pinta \
    obsidian \
    moonlight-qt
fi
