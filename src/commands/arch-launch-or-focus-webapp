#!/bin/bash

# arch:summary=Launch or focus on a given web app identified by the window-pattern.
# arch:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: arch-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="arch-launch-webapp $@"

exec arch-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
