#!/bin/bash

# arch:summary=Cycle the current active workspace through tiling and scrolling layouts
# arch:args=[back]

# Layout changes replace one notification instead of stacking a new one for
# each press, so cycling through the layouts leaves a single, current one.
notify_layout() {
  local state="${XDG_STATE_HOME:-$HOME/.local/state}/arch/workspace-layout-notification"
  local last id
  [[ -r $state ]] && read -r last <"$state"
  if id=$(arch-notification-send -p -r "${last:-0}" -g 󱂬 "$1") && [[ $id =~ ^[0-9]+$ ]]; then
    mkdir -p "$(dirname "$state")" && printf '%s\n' "$id" >"$state"
  fi
}

DIRECTION=${1:-next}
if [[ $DIRECTION != "next" && $DIRECTION != "back" ]]; then
  echo "Usage: arch-hyprland-workspace-layout-toggle [back]" >&2
  exit 1
fi

ACTIVE_WORKSPACE=$(hyprctl activeworkspace -j | jq -r '.id')
# Named workspaces report a negative id, and Hyprland reads a leading "-" as a
# selector relative to the current workspace: targeting one lands on workspace 1
# and reconfigures that instead.
[[ $ACTIVE_WORKSPACE =~ ^[0-9]+$ ]] || exit 1
MODES_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/arch/workspace-layouts"
MODE_FILE="$MODES_DIR/$ACTIVE_WORKSPACE.lua"

CURRENT_MODE=$(archctl hyprland workspace layout current)

case "$CURRENT_MODE" in
  tiling) NEW_MODE=scrolling ;;
  scrolling) NEW_MODE=tiling ;;
  *) NEW_MODE=scrolling ;;
esac

APPLY="o.workspace_mode({ workspace = \"$ACTIVE_WORKSPACE\", mode = \"$NEW_MODE\" })"

# Each layout has whole sentences of its own, so a translation can inflect it.
case $NEW_MODE in
  tiling)
    SET_MESSAGE=$(arch-i18n layout.workspaceTiling)
    UNSAVED_MESSAGE=$(arch-i18n layout.workspaceTilingUnsaved)
    ;;
  scrolling)
    SET_MESSAGE=$(arch-i18n layout.workspaceScrolling)
    UNSAVED_MESSAGE=$(arch-i18n layout.workspaceScrollingUnsaved)
    ;;
esac

# Saving a mode that did not apply would leave the file naming one layout while
# the screen shows another, and restore it at the next login.
APPLIED=0
if hyprctl eval "$APPLY" >/dev/null 2>&1; then
  APPLIED=1
fi

if (( ! APPLIED )); then
  notify_layout "$(arch-i18n layout.needsReload)"
elif [[ $NEW_MODE == "$(arch-hyprland-workspace-layout-default)" ]] && rm -f "$MODE_FILE"; then
  # Cycled onto the default, a workspace goes back to following it, so a later
  # change of the default reaches it too.
  notify_layout "$SET_MESSAGE"
elif mkdir -p "$MODES_DIR" && printf '%s\n' "$APPLY" >"$MODE_FILE"; then
  notify_layout "$SET_MESSAGE"
else
  # The mode is on screen but nothing will bring it back, and the next press
  # reads the mode from this file, so say so rather than counting it as set.
  notify_layout "$UNSAVED_MESSAGE"
fi

# Refresh workspace indicators and dock state after applying the layout.
if (( APPLIED )); then
  arch-shell -q arch.workspaces refresh
fi
