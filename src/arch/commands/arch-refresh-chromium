#!/bin/bash

# arch:summary=Refresh the ~/.config/chromium-flags.conf file from the Arch defaults.

CONFIG_FILE="$HOME/.config/chromium-flags.conf"
INSTALL_GOOGLE_ACCOUNTS=false

# Check if google accounts were installed
if [[ -f $CONFIG_FILE ]] && \
  grep -q -- "--oauth2-client-id" "$CONFIG_FILE" && \
  grep -q -- "--oauth2-client-secret" "$CONFIG_FILE"; then
  INSTALL_GOOGLE_ACCOUNTS=true
fi

# Refresh the Chromium configuration
archctl refresh config chromium-flags.conf

# Install/refresh the native messaging hosts used by the bundled extensions
archctl install chromium copy-url
archctl install chromium yt-dlp

# Re-install Google accounts if previously configured
if [[ $INSTALL_GOOGLE_ACCOUNTS == "true" ]]; then
  arch-install-chromium-google-account
fi

# Put the Snapdragon video decoding settings back. Last, so a failure here is
# the command's result.
arch-install-video-decode
