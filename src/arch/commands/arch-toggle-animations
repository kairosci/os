#!/bin/bash

# arch:summary=Toggle animations, blur and shadows, which are slow without a GPU
# arch:args=[toggle|on|off]
# arch:examples=archctl toggle animations | archctl toggle animations off | archctl toggle animations on

# The flag records animations being off, so on and off swap on the way through.
case ${1:-toggle} in
toggle) arch-hyprland-toggle no-animations toggle ;;
on) arch-hyprland-toggle no-animations off ;;
off) arch-hyprland-toggle no-animations on ;;
*)
  echo "Usage: arch-toggle-animations [toggle|on|off]" >&2
  exit 1
  ;;
esac

if archctl hyprland toggle enabled no-animations; then
  archctl notification send -g 󰗘 "$(arch-i18n animations.disabled)"
else
  archctl notification send -g 󰗘 "$(arch-i18n animations.enabled)"
fi
