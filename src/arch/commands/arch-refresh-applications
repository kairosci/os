#!/bin/bash

# arch:summary=Ensure default application launchers are installed.

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
cp "$AP"/applications/*.desktop ~/.local/share/applications/

if archctl cmd present alacritty; then
  cp "$AP/default/alacritty/Alacritty.desktop" ~/.local/share/applications/
fi

update-desktop-database ~/.local/share/applications
