#!/bin/bash

# arch:summary=Overwrite all the user Hyprland Lua configs in ~/.config/hypr with the Arch defaults.

archctl refresh config hypr/.luarc.json
archctl refresh config hypr/autostart.lua
archctl refresh config hypr/bindings.lua
archctl refresh config hypr/input.lua
archctl refresh config hypr/looknfeel.lua
archctl refresh config hypr/hyprland.lua
archctl refresh config hypr/monitors.lua

mkdir -p ~/.local/state/arch/toggles/hypr
cp "$AP/default/hypr/toggles/flags.lua" ~/.local/state/arch/toggles/hypr/
