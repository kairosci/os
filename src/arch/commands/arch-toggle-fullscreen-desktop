#!/bin/bash

# arch:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# arch:args=[toggle|on|off]
# arch:examples=archctl toggle fullscreen desktop | archctl toggle fullscreen desktop off | archctl toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if arch-toggle-enabled bar-off && archctl hyprland toggle enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: arch-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

arch-toggle-bar "$ACTION"
archctl hyprland toggle window-no-gaps "$ACTION"
