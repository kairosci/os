#!/bin/bash

# arch:summary=Reinstall Arch packages and reset default configs
# arch:requires-sudo=true

set -e

echo -e "This will reinstall all default os packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  arch-reinstall-pkgs
  arch-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && arch-system reboot
fi
