#!/bin/bash

# arch:summary=Open the Docker TUI (lazydocker) with access to the Docker daemon
# arch:hidden=true

# Docker group membership is root-equivalent. Gate access to the root-owned
# daemon socket behind Polkit unless the current session can already reach it.
# pkexec sanitizes the environment, so carry TERM through for the TUI to render
# and run lazydocker from root's PATH.
if arch-sudo-docker; then
  exec pkexec /usr/bin/env TERM="${TERM:-xterm-256color}" lazydocker
else
  exec lazydocker
fi
