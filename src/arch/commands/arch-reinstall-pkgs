#!/bin/bash

# arch:summary=Reinstall all default Arch packages from the stable channel, or on Apple Silicon the edge channel
# arch:requires-sudo=true

set -e

# Reinstall all default os packages from the platform's default channel
# (stable, or edge on Apple Silicon) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
source "$AP/installer/helpers/pacman.sh"
platform=$(arch-hw-platform)
channel=$(arch_pacman_default_channel "$platform")
arch-refresh-pacman "$channel"

# Downgrade any packages to that channel's setup
arch-update-pacman -Suu --noconfirm

# Ensure this platform's default packages are installed
default_packages=$(arch-pkg-defaults)
mapfile -t packages <<<"$default_packages"
arch-update-pacman -Syu --noconfirm --needed "${packages[@]}"
