#!/bin/bash

# arch:summary=Set and show lightweight desktop notification reminders
# arch:args=[-i|--interactive] | <minutes> [message] | show [-j|--json] | clear
# arch:examples=arch reminder -i | arch reminder 5 | arch reminder 30 "Check the oven" | arch reminder show | arch reminder show --json | arch reminder clear

set -euo pipefail

format_remaining() {
  local seconds=$1
  local minutes=$((seconds / 60))
  local remainder=$((seconds % 60))

  if ((minutes > 0 && remainder > 0)); then
    arch-i18n reminder.durationMinutesSeconds "$minutes" "$remainder"
  elif ((minutes > 0)); then
    arch-i18n battery.durationMinutes "$minutes"
  else
    arch-i18n reminder.durationSeconds "$remainder"
  fi
  echo
}

active_reminder_timers() {
  local now=${1:-$(date +%s)}
  local timer next

  while IFS=$'\t' read -r timer next; do
    [[ -z $timer || -z $next ]] && continue

    next=$((next / 1000000))
    ((next <= now)) && continue

    printf "%s\t%s\n" "$timer" "$next"
  done < <(systemctl --user list-timers --all --output=json "arch-reminder-*.timer" 2>/dev/null | jq -r '.[] | [.unit, .next] | @tsv')
}

refresh_indicator() {
  arch-shell -q arch.indicators refresh >/dev/null 2>&1 || true
}

open_interactive() {
  arch-shell shell summon arch.reminders "{}"
}

show_reminders() {
  local timer next remaining reminder reminder_minutes body=""
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/arch-reminders"
  local reminder_message=""
  local now=$(date +%s)

  while IFS=$'\t' read -r timer next; do
    remaining=$((next - now))
    reminder=${timer%.timer}
    reminder=${reminder#arch-reminder-}
    reminder_minutes=${reminder%%m-*}
    reminder_message=""
    [[ -f $reminder_dir/${timer%.timer}.message ]] && reminder_message=$(<"$reminder_dir/${timer%.timer}.message")

    [[ -n $reminder_message ]] || reminder_message=$(arch-i18n reminder.minuteLabel "$reminder_minutes")
    body+="$(arch-i18n reminder.inRemaining "$reminder_message" "$(format_remaining $remaining)" "$(date -d "@$next" +%-H:%M)")"$'\n'
  done < <(active_reminder_timers "$now")

  if [[ -z $body ]]; then
    arch-notification-send -g 󰢌 "$(arch-i18n reminder.upcoming)" "$(arch-i18n reminder.none)"
  else
    arch-notification-send -g 󰢌 "$(arch-i18n reminder.upcoming)" "${body%$'\n'}"
  fi
}

show_json() {
  local timer next remaining reminder reminder_minutes unit reminder_message label item_json reminders_json="[]"
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/arch-reminders"
  local now=$(date +%s)
  local count=0
  local tooltip
  tooltip=$(arch-i18n reminder.setTooltip)

  while IFS=$'\t' read -r timer next; do
    count=$((count + 1))

    unit=${timer%.timer}
    reminder=${unit#arch-reminder-}
    reminder_minutes=${reminder%%m-*}
    [[ ! $reminder_minutes =~ ^[0-9]+$ ]] && reminder_minutes=0
    remaining=$((next - now))
    reminder_message=""
    [[ -f $reminder_dir/$unit.message ]] && reminder_message=$(<"$reminder_dir/$unit.message")

    if [[ -n $reminder_message ]]; then
      label=$reminder_message
    else
      label=$(arch-i18n reminder.minuteLabel "$reminder_minutes")
    fi

    item_json=$(jq -cn \
      --arg unit "$unit" \
      --arg timer "$timer" \
      --arg label "$label" \
      --arg message "$reminder_message" \
      --arg remaining "$(format_remaining "$remaining")" \
      --arg atTime "$(date -d "@$next" +%-H:%M)" \
      --argjson minutes "$reminder_minutes" \
      --argjson at "$next" \
      --argjson remainingSeconds "$remaining" \
      '{unit:$unit,timer:$timer,minutes:$minutes,message:$message,label:$label,remaining:$remaining,remainingSeconds:$remainingSeconds,at:$at,atTime:$atTime}')
    reminders_json=$(jq -cn --argjson reminders "$reminders_json" --argjson item "$item_json" '$reminders + [$item]')
  done < <(active_reminder_timers "$now")

  if ((count > 0)); then
    tooltip=$(arch-i18n --count "$count" reminder.count "$count")
  fi

  jq -cn --argjson count "$count" --arg tooltip "$tooltip" --argjson reminders "$reminders_json" '{count:$count,active:($count > 0),tooltip:$tooltip,reminders:$reminders}'
}

clear_reminders() {
  local units
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/arch-reminders"

  units=$(systemctl --user list-timers --all --no-legend --no-pager "arch-reminder-*.timer" 2>/dev/null | awk '{ print $(NF - 1), $NF }')

  if [[ -n $units ]]; then
    xargs -r systemctl --user stop <<<"$units" || true
  fi

  rm -f "$reminder_dir"/arch-reminder-*.message 2>/dev/null || true
  refresh_indicator
  arch-notification-send -g 󰢌 "$(arch-i18n reminder.cleared)"
}

usage() {
  echo "Usage: arch-reminder [-i|--interactive]"
  echo "       arch-reminder <minutes> [message]"
  echo "       arch-reminder show [-j|--json]"
  echo "       arch-reminder clear"
}

case ${1:-} in
-i | --interactive)
  open_interactive
  exit 0
  ;;
show | list)
  case ${2:-} in
  -j | --json)
    show_json
    ;;
  "")
    show_reminders
    ;;
  *)
    usage
    exit 1
    ;;
  esac
  exit 0
  ;;
clear)
  clear_reminders
  exit 0
  ;;
esac

minutes=${1:-}
shift || true
message="$*"
custom_message="$message"

if [[ -z $minutes ]] || [[ ! $minutes =~ ^[0-9]+$ ]] || ((minutes == 0)); then
  usage
  exit 1
fi

if [[ -z $message ]]; then
  message=$(arch-i18n --count "$minutes" reminder.minutesUp "$minutes")
fi

set_at=$(date +%s)
remind_at=$(date -d "+${minutes} minutes" +%H:%M)
unit="arch-reminder-${minutes}m-$set_at"
reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/arch-reminders"
message_file="$reminder_dir/$unit.message"
confirmation=$(arch-i18n reminder.willRemindAt "$remind_at")
confirmation_title=$(arch-i18n --count "$minutes" reminder.setForMinutes "$minutes")

mkdir -p "$reminder_dir"

if [[ -n $custom_message ]]; then
  printf "%s" "$custom_message" >"$message_file"
  confirmation_title=$(arch-i18n --count "$minutes" reminder.customInMinutes "$custom_message" "$minutes")
fi

systemd-run --user --quiet --collect --on-active="${minutes}m" --unit="$unit" \
  bash -c 'arch-notification-send -g 󰢌 "$(arch-i18n reminder.title)" "$1"; rm -f "$2"; arch-shell -q arch.indicators refresh >/dev/null 2>&1 || true' bash "$message" "$message_file"

refresh_indicator
arch-notification-send -g 󰢌 "$confirmation_title" "$confirmation"
