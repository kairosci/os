#!/bin/bash

# arch:summary=Show the current Arch dev-link state
# arch:group=dev

set -euo pipefail

default_target="/usr/share/arch"
sudoers_file="/etc/sudoers.d/arch-dev-path"
configured="$default_target"
conf_present=0
linked=0
conf_file=/etc/arch.conf
[[ -f $conf_file ]] || conf_file=/etc/arch.conf

if [[ -f $conf_file ]]; then
  conf_present=1
  configured=$(
    AP=
    # shellcheck disable=SC1091
    . "$conf_file"
    printf '%s' "${AP:-<empty>}"
  )
  if [[ $configured != "$default_target" ]]; then
    linked=1
  fi
fi

# /etc/sudoers.d is root-only, so report what sudo resolves rather than reading
# the drop-in — and say so plainly instead of guessing when there is no cached
# credential to ask with. A missing entry here is what makes `sudo arch-*`
# run the packaged copy of a command the checkout has changed.
sudo_bin_dir() {
  local resolved

  if ! sudo -n true 2>/dev/null; then
    echo "unknown (needs sudo)"
    return
  fi

  resolved=$(sudo -n bash -c 'type -P arch-dev-status' 2>/dev/null) || {
    echo "not on sudo's PATH"
    return
  }

  dirname "$resolved"
}

if (( linked )); then
  echo "dev-link: configured"
  echo "  $conf_file -> AP=$configured"
  echo "  sudo resolves arch-* from: $(sudo_bin_dir)"
  echo "  status: reboot required before all session layers use this checkout"
else
  echo "dev-link: inactive"
  if (( conf_present )); then
    echo "  $conf_file -> AP=$configured (default guard)"
  fi
fi

echo "  current shell:       AP=${AP:-<unset>}"

if [[ ${AP:-$default_target} != "$configured" ]]; then
  echo
  echo "Note: the running session does not match $conf_file. Reboot to settle it."
fi
