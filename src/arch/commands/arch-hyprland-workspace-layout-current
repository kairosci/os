#!/bin/bash

# arch:summary=Print a workspace layout: tiling or scrolling
# arch:args=[workspace-id]

if [[ -n $1 ]]; then
  WORKSPACE_ID=$1
  TILED_LAYOUT=$(hyprctl workspaces -j | jq -r --arg id "$WORKSPACE_ID" 'first(.[] | select((.id | tostring) == $id) | .tiledLayout) // empty')
else
  read -r WORKSPACE_ID TILED_LAYOUT < <(hyprctl activeworkspace -j | jq -r '"\(.id) \(.tiledLayout // "")"')
fi

MODES_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/arch/workspace-layouts"

# Hyprland only reports the tiled layout, and floating is not one, so the mode is
# read back from the file arch-hyprland-workspace-layout-toggle wrote. Files
# saved before floating existed name no mode, and a workspace without a mode of
# its own follows the default layout.
if [[ $WORKSPACE_ID =~ ^[0-9]+$ ]] && (( WORKSPACE_ID >= 1 )); then
  MODE=$(sed -n 's/.*mode = "\([a-z]*\)".*/\1/p' "$MODES_DIR/$WORKSPACE_ID.lua" 2>/dev/null)

  if [[ -z $MODE && -f $MODES_DIR/default.lua ]]; then
    MODE=$(arch-hyprland-workspace-layout-default)
  fi
fi

MODE=${MODE:-$TILED_LAYOUT}
case $MODE in
  tiling|dwindle) echo tiling ;;
  scrolling|floating) echo scrolling ;;
  *) echo scrolling ;;
esac
