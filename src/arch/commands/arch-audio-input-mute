#!/bin/bash

# arch:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  arch-brightness-keyboard-mute on
  arch-osd -i microphone-muted -m "$(arch-i18n audio.micMuted)"
else
  arch-brightness-keyboard-mute off
  arch-osd -i microphone -m "$(arch-i18n audio.micOn)"
fi
