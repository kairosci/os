#!/bin/bash

# arch:summary=Toggle suspend availability in the system menu

if archctl sleep disabled; then
  archctl notification send -g 󰒲 "$(arch-i18n suspend.turnedOffOnMachine)"
  exit 0
fi

arch-toggle suspend-off

if archctl toggle enabled suspend-off; then
  archctl notification send -g 󰒲 "$(arch-i18n suspend.removedFromMenu)"
else
  archctl notification send -g 󰒲 "$(arch-i18n suspend.availableInMenu)"
fi
