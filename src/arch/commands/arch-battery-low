#!/bin/bash

# arch:summary=Send the low battery warning notification and run battery-low hooks.
# arch:args=<percentage>
# arch:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: arch-battery-low <percentage>" >&2
  exit 1
fi

level=$1

arch-notification-send -g 󱐋 -u critical "$(arch-i18n battery.lowTitle)" "$(arch-i18n battery.lowBody "$level")" -i battery-caution -t 30000
archctl hook battery-low "$level"
