#!/bin/bash

# arch:summary=Install and configure Voxtype dictation
# arch:requires-sudo=true

set -e

voxtype_lib_path="${ARCH_VOXTYPE_LIB_PATH:-/usr/lib/voxtype}"

if arch-cmd-missing voxtype; then
  if gum confirm --affirmative "$(arch-i18n common.yes)" --negative "$(arch-i18n common.no)" "$(arch-i18n dictation.installVoxtype)"; then
    arch-pkg-add wtype voxtype-bin
  else
    exit 0
  fi
fi

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$config_home/voxtype"
if [[ ! -e $config_home/voxtype/config.toml ]]; then
  cp "$AP/default/voxtype/config.toml" "$config_home/voxtype/"
  # A Vulkan runtime is not enough: aarch64 voxtype-bin ships no Vulkan backend.
  if archctl hw vulkan && [[ -x $voxtype_lib_path/voxtype-vulkan ]]; then
    voxtype setup gpu --enable || true
  fi
fi

# Setup reuses the configured model and downloads it only when missing.
# Retry these steps even when an earlier attempt already installed the binary.
voxtype setup --download --no-post-install
voxtype setup systemd
systemctl --user enable --now voxtype.service

arch-dictation-use voxtype
hyprctl reload >/dev/null
arch-notification-send -g  "$(arch-i18n dictation.voxtypeReady)" "$(arch-i18n dictation.hint)" -t 10000
