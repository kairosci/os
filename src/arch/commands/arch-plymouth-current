#!/bin/bash

# arch:summary=Show which theme is styling the Plymouth boot screen
# arch:examples=arch plymouth current

# arch-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/arch/logo.png

if cmp -s "$AP/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

arch-plymouth-list | while read -r name; do
  if cmp -s "$(archctl theme dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
