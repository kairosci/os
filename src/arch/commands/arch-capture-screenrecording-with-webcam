#!/bin/bash

# arch:summary=Pick a webcam and start a screen recording with it
# arch:examples=archctl capture screenrecording-with-webcam

mapfile -t devices < <(archctl capture webcam list)
if (( ${#devices[@]} == 0 )); then
  archctl notification send "$(arch-i18n capture.noWebcam)" -u critical -t 3000
  exit 1
fi

if (( ${#devices[@]} == 1 )); then
  device="${devices[0]%%[[:space:]]*}"
else
  selection=$(arch-menu-select "$(arch-i18n capture.selectWebcam)" "${devices[@]}" -- --width 520 --maxheight 520) || exit 1
  device="${selection%%[[:space:]]*}"
fi

exec arch-capture-screenrecording \
  --with-desktop-audio --with-microphone-audio \
  --with-webcam --webcam-device="$device"
