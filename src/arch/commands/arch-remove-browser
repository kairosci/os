#!/bin/bash

# arch:summary=Remove a supported browser and clean up Arch browser defaults
# arch:args=<chrome|brave|brave-origin|edge|firefox|zen>
# arch:examples=arch remove browser firefox | arch remove browser brave
# arch:requires-sudo=true

set_fallback_default_browser() {
  local current_browser
  current_browser=$(archctl default browser desktop-id)

  if [[ $current_browser != $1 ]]; then
    return
  fi

  if archctl cmd present chromium; then
    env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser chromium.desktop || true
  fi
}

case $1 in
chrome)
  echo "Removing Chrome..."
  set_fallback_default_browser google-chrome.desktop
  arch-pkg-drop google-chrome
  rm -f ~/.config/chrome-flags.conf
  sudo rm -f /etc/opt/chrome/policies/managed/color.json /etc/opt/chrome/policies/managed/arch.json
  ;;
edge)
  echo "Removing Edge..."
  set_fallback_default_browser microsoft-edge.desktop
  arch-pkg-drop microsoft-edge-stable-bin
  rm -f ~/.config/microsoft-edge-stable-flags.conf
  sudo rm -f /etc/opt/edge/policies/managed/color.json /etc/opt/edge/policies/managed/arch.json
  ;;
brave)
  echo "Removing Brave..."
  set_fallback_default_browser brave-browser.desktop
  arch-pkg-drop brave-bin
  rm -f ~/.config/brave-flags.conf

  if archctl pkg missing brave-origin-bin; then
    sudo rm -rf /etc/brave
  fi
  ;;
brave-origin)
  echo "Removing Brave Origin..."
  set_fallback_default_browser brave-origin.desktop
  arch-pkg-drop brave-origin-bin
  rm -f ~/.config/brave-origin-flags.conf

  if archctl pkg missing brave-bin; then
    sudo rm -rf /etc/brave
  fi
  ;;
firefox)
  echo "Removing Firefox..."
  set_fallback_default_browser firefox.desktop
  arch-pkg-drop firefox
  ;;
zen)
  echo "Removing Zen..."
  set_fallback_default_browser zen.desktop
  arch-pkg-drop zen-browser-bin
  ;;
*)
  echo "Usage: arch-remove-browser <chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
  ;;
esac
