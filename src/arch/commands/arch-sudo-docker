#!/bin/bash

# arch:summary=Succeed when Docker needs sudo
# arch:hidden=true

# Docker group membership is root-equivalent and is not granted by Arch.
# Succeeds when the daemon socket needs privilege, so callers can use it as a condition.

DOCKER_SOCKET="${ARCH_DOCKER_SOCKET:-/var/run/docker.sock}"

if (( $# != 0 )); then
  echo "Usage: arch-sudo-docker" >&2
  exit 2
fi

# A socket we can write is a daemon we can drive without elevating. A missing
# socket counts as needing sudo: reaching it means starting it as root anyway.
[[ -w $DOCKER_SOCKET ]] && exit 1
exit 0
