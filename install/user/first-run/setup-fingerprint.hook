#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if arch-hw-fingerprint && [[ ! -f /etc/pam.d/arch-lock-fingerprint ]] &&
  arch-done ensure fingerprint-setup-invitation; then
  arch-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec arch-launch-floating-terminal-with-presentation arch-setup-security-fingerprint
fi
