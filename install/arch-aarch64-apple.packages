# Apple Silicon additions, composed after arch-base.packages and
# arch-aarch64.packages (arch-pkg-defaults aarch64-apple); never on Intel
# Macs or other aarch64 machines. The kernel and boot chain come with the
# Mac's image, as the kernel and bootloader do from the ISO on x86_64. What a
# Mac cannot work without (its speaker stack, audio server and GPU driver)
# comes as arch-mac's dependencies, so a new Mac driver needs no change
# here; the rest are defaults an owner may remove.

# The Mac's runtime and boot packages (omacom/arch-mac-pkgs).
arch-mac
arch-mac-boot

# Picks the startup volume (macOS or os) from Linux.
asahi-bless

# Hardware video decode.
avd-fw
libva-v4l2_request-avd

# Widevine for DRM streaming.
widevine

# Screen recording: gpu-screen-recorder finds no display device to capture on
# Apple Silicon, whose display and GPU are separate DRM devices, so recording
# falls back to wf-recorder (arch-capture-screenrecording).
wf-recorder
