diff --git a/archiso/mkarchiso b/archiso/mkarchiso
--- a/archiso/mkarchiso
+++ b/archiso/mkarchiso
@@ -731,7 +731,7 @@
 
 # Prepare GRUB
 _make_bootmode_uefi.grub() {
-    local grub_target grubmodules=() files_to_copy=()
+    local grub_target grubmodules=() grubmodules_platform=() grubmodule files_to_copy=()
 
     _msg_info "Setting up GRUB for UEFI booting..."
 
@@ -751,6 +751,18 @@
                  minicmd normal ntfs ntfscomp part_apple part_gpt part_msdos png read reboot regexp search \
                  search_fs_file search_fs_uuid search_label serial sleep tpm udf usb usbserial_common usbserial_ftdi \
                  usbserial_pl2303 usbserial_usbdebug video xfs zstd)
+
+    # Arch Linux ARM does not ship the AT/PS/2 keyboard module for arm64-efi.
+    # Use the supported USB keyboard module on ARM instead.
+    if [[ "$arch" == 'aarch64' ]]; then
+        for grubmodule in "${grubmodules[@]}"; do
+            if [[ "$grubmodule" != 'at_keyboard' ]]; then
+                grubmodules_platform+=("$grubmodule")
+            fi
+        done
+        grubmodules_platform+=(usb_keyboard)
+        grubmodules=("${grubmodules_platform[@]}")
+    fi
 
     # Set up GRUB in ISO 9660. This allows creating a medium for the live environment by using
