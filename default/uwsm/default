# Changes require a restart to take effect.

# The session name comes from SDDM's desktop-file basename. Keep the exported
# session identity branded even while an old SDDM entry is being migrated.
export DESKTOP_SESSION=arch

# Install other terminals via Install > Terminal
export TERMINAL=xdg-terminal-exec

# BROWSER is intentionally not exported here: session-wide, it makes xdg-settings
# refuse to change the default browser, which breaks the browsers' own "Set as
# default" buttons. Interactive shells get BROWSER from default/bash/envs instead.

# Used by terminal programs to open files with the selected os default editor
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"

# A dev-linked checkout owns the commands the session invokes. Keep it ahead
# of the packaged copies so CLI lookups and sudo commands agree on one tree.
if [[ -n ${ARCH_PATH:-} && -d ${ARCH_PATH%/}/src/commands ]]; then
  case ":$PATH:" in
    *":${ARCH_PATH%/}/src/commands:"*) ;;
    *) PATH="${ARCH_PATH%/}/src/commands${PATH:+:$PATH}" ;;
  esac
  export PATH
fi

