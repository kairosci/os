  "setup.reset": {"icon":"󰑓","label":"Reset Computer","when":"[[ $(findmnt -no FSTYPE /) == btrfs ]]","action":"arch-launch-terminal-with-presentation arch-system-factory-reset"},

  // Install
  "install.package": {"icon":"󰣇","label":"Packages (pacman)"},
  "install.package.install": {"icon":"󰐕","label":"Install Packages","action":"xdg-terminal-exec --app-id=org.arch.terminal bash -lc 'read -r -p \"Package names: \" -a packages; if (( ${#packages[@]} )); then sudo pacman -S -- \"${packages[@]}\"; fi; read -r -p \"Press Enter to close\" _'"},
  "install.package.remove": {"icon":"󰍴","label":"Remove Packages","action":"xdg-terminal-exec --app-id=org.arch.terminal bash -lc 'read -r -p \"Package names: \" -a packages; if (( ${#packages[@]} )); then sudo pacman -Rns -- \"${packages[@]}\"; fi; read -r -p \"Press Enter to close\" _'"},
