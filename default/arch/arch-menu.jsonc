{
  // Menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. provider:"name" points a submenu at one of
  // the shell's providers (the providers map in src/arch/shell/plugins/menu/Menu.qml);
  // new provider names cannot be declared here. See docs/menu.md.
  // Optional fields:
  //   aliases        alternate `archctl menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds
  //   disabled       shell condition; when it succeeds the row stays listed but
  //                  goes dim, takes a ✓ and can no longer be selected. Install
  //                  rows use it so software already on the machine reads as
  //                  installed instead of vanishing from the list.

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "appearance": {"icon":"󰏘","label":"Appearance","aliases":["style"]},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"arch-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"arch-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! archctl toggle enabled suspend-off && ! archctl sleep disabled","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"archctl hibernation available && ! archctl sleep disabled","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"arch-system logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"arch-system reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"arch-system shutdown"},

  // Appearance
  "appearance.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"arch-shell shell summon arch.image-picker '{\"source\":\"themes\"}'"},
  "appearance.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(arch-theme-bg-switcher); [[ -n $background ]] && arch-theme-bg-set \"$background\""},
  "appearance.font": {"icon":"","label":"Font","provider":"fonts"},
  "appearance.top-bar": {"icon":"󰍜","label":"Menu Bar"},
  "appearance.top-bar.hide": {"icon":"󰈉","label":"Hide Bar","when":"! archctl toggle enabled bar-off","action":"archctl toggle bar off"},
  "appearance.top-bar.show": {"icon":"󰈈","label":"Show Bar","when":"archctl toggle enabled bar-off","action":"archctl toggle bar on"},
  "appearance.top-bar.position": {"icon":"","label":"Position Bar"},
  "appearance.top-bar.background": {"icon":"󰂵","label":"Bar Background"},
  "appearance.top-bar.background.opaque": {"icon":"󰝤","label":"Opaque Bar","checked":"[[ $(arch-bar background) == \"opaque\" ]]","action":"arch-bar background opaque"},
  "appearance.top-bar.background.glassy": {"icon":"󰂵","label":"Glassy Bar","checked":"[[ $(arch-bar background) == \"glassy\" ]]","action":"arch-bar background glassy"},
  "appearance.top-bar.background.clear": {"icon":"󰝣","label":"Clear Bar","checked":"[[ $(arch-bar background) == \"none\" ]]","action":"arch-bar background none"},
  "appearance.top-bar.indicators": {"icon":"󰋽","label":"Bar Indicators"},
  "appearance.top-bar.indicators.battery-percentage-on": {"icon":"󰁹","label":"Show Battery %","when":"archctl hw laptop && [[ $(arch-bar get arch.power showPercentage) != true ]]","action":"arch-shell arch.power togglePercentage"},
  "appearance.top-bar.indicators.battery-percentage-off": {"icon":"󰁹","label":"Hide Battery %","when":"archctl hw laptop && [[ $(arch-bar get arch.power showPercentage) == true ]]","action":"arch-shell arch.power togglePercentage"},
  "appearance.top-bar.indicators.clock": {"icon":"󰥔","label":"Clock"},
  "appearance.top-bar.indicators.clock.sunday-24h": {"icon":"󰥔","label":"Sunday 14:30","when":"[[ $(arch-bar position) != \"left\" && $(arch-bar position) != \"right\" ]]","checked":"[[ $(arch-bar get arch.clock format) == \"dddd HH:mm\" ]]","action":"arch-bar set arch.clock format \"dddd HH:mm\""},
  "appearance.top-bar.indicators.clock.sunday-12h": {"icon":"󰥔","label":"Sunday 2:30 PM","when":"[[ $(arch-bar position) != \"left\" && $(arch-bar position) != \"right\" ]]","checked":"[[ $(arch-bar get arch.clock format) == \"dddd h:mm AP\" ]]","action":"arch-bar set arch.clock format \"dddd h:mm AP\""},
  "appearance.top-bar.indicators.clock.sunday-seconds-24h": {"icon":"󰥔","label":"Sunday 14:30:05","when":"[[ $(arch-bar position) != \"left\" && $(arch-bar position) != \"right\" ]]","checked":"[[ $(arch-bar get arch.clock format) == \"dddd HH:mm:ss\" ]]","action":"arch-bar set arch.clock format \"dddd HH:mm:ss\""},
  "appearance.top-bar.indicators.clock.sunday-seconds-12h": {"icon":"󰥔","label":"Sunday 2:30:05 PM","when":"[[ $(arch-bar position) != \"left\" && $(arch-bar position) != \"right\" ]]","checked":"[[ $(arch-bar get arch.clock format) == \"dddd h:mm:ss AP\" ]]","action":"arch-bar set arch.clock format \"dddd h:mm:ss AP\""},
  "appearance.top-bar.indicators.clock.time-24h": {"icon":"󰥔","label":"14:30","when":"[[ $(arch-bar position) != \"left\" && $(arch-bar position) != \"right\" ]]","checked":"[[ $(arch-bar get arch.clock format) == \"HH:mm\" ]]","action":"arch-bar set arch.clock format \"HH:mm\""},
  "appearance.top-bar.indicators.clock.time-12h": {"icon":"󰥔","label":"2:30 PM","when":"[[ $(arch-bar position) != \"left\" && $(arch-bar position) != \"right\" ]]","checked":"[[ $(arch-bar get arch.clock format) == \"h:mm AP\" ]]","action":"arch-bar set arch.clock format \"h:mm AP\""},
  "appearance.top-bar.indicators.clock.date-24h": {"icon":"󰥔","label":"Sun 3 May 14:30","when":"[[ $(arch-bar position) != \"left\" && $(arch-bar position) != \"right\" ]]","checked":"[[ $(arch-bar get arch.clock format) == \"ddd d MMM HH:mm\" ]]","action":"arch-bar set arch.clock format \"ddd d MMM HH:mm\""},
  "appearance.top-bar.indicators.clock.date-12h": {"icon":"󰥔","label":"Sun 3 May 2:30 PM","when":"[[ $(arch-bar position) != \"left\" && $(arch-bar position) != \"right\" ]]","checked":"[[ $(arch-bar get arch.clock format) == \"ddd d MMM h:mm AP\" ]]","action":"arch-bar set arch.clock format \"ddd d MMM h:mm AP\""},
  "appearance.top-bar.indicators.clock.week": {"icon":"󰥔","label":"3 May W18 2026","when":"[[ $(arch-bar position) != \"left\" && $(arch-bar position) != \"right\" ]]","checked":"[[ $(arch-bar get arch.clock format) == \"d MMMM 'W'ww yyyy\" ]]","action":"arch-bar set arch.clock format \"d MMMM 'W'ww yyyy\""},
  "appearance.top-bar.indicators.clock.iso": {"icon":"󰥔","label":"2026-05-03 14:30","when":"[[ $(arch-bar position) != \"left\" && $(arch-bar position) != \"right\" ]]","checked":"[[ $(arch-bar get arch.clock format) == \"yyyy-MM-dd HH:mm\" ]]","action":"arch-bar set arch.clock format \"yyyy-MM-dd HH:mm\""},
  "appearance.top-bar.indicators.clock.stacked-24h": {"icon":"󰥔","label":"14 — 30","when":"[[ $(arch-bar position) == \"left\" || $(arch-bar position) == \"right\" ]]","checked":"[[ $(arch-bar get arch.clock verticalFormat) == $'HH\\n—\\nmm' ]]","action":"arch-bar set arch.clock verticalFormat $'HH\\n—\\nmm'"},
  "appearance.top-bar.indicators.clock.stacked-12h": {"icon":"󰥔","label":"2 — 30 PM","when":"[[ $(arch-bar position) == \"left\" || $(arch-bar position) == \"right\" ]]","checked":"[[ $(arch-bar get arch.clock verticalFormat) == $'h\\n—\\nmm\\nAP' ]]","action":"arch-bar set arch.clock verticalFormat $'h\\n—\\nmm\\nAP'"},
  "appearance.top-bar.indicators.clock.stacked-date": {"icon":"󰥔","label":"03 May W18 '26","when":"[[ $(arch-bar position) == \"left\" || $(arch-bar position) == \"right\" ]]","checked":"[[ $(arch-bar get arch.clock verticalFormat) == $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy' ]]","action":"arch-bar set arch.clock verticalFormat $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy'"},
  "appearance.top-bar.indicators.clock.stacked-time": {"icon":"󰥔","label":"14 30","when":"[[ $(arch-bar position) == \"left\" || $(arch-bar position) == \"right\" ]]","checked":"[[ $(arch-bar get arch.clock verticalFormat) == $'HH\\nmm' ]]","action":"arch-bar set arch.clock verticalFormat $'HH\\nmm'"},
  "appearance.top-bar.position.top": {"icon":"󰁝","label":"Top Bar","action":"arch-bar position top"},
  "appearance.top-bar.position.bottom": {"icon":"󰁅","label":"Bottom Bar","action":"arch-bar position bottom"},
  "appearance.top-bar.position.left": {"icon":"󰁍","label":"Left Bar","action":"arch-bar position left"},
  "appearance.top-bar.position.right": {"icon":"󰁔","label":"Right Bar","action":"arch-bar position right"},
  "appearance.windows": {"icon":"󰖲","label":"Windows"},
  "appearance.windows.gaps-on": {"icon":"","label":"Window Gaps On","when":"archctl hyprland toggle enabled window-no-gaps","action":"archctl hyprland toggle window-no-gaps"},
  "appearance.windows.gaps-off": {"icon":"","label":"Window Gaps Off","when":"! archctl hyprland toggle enabled window-no-gaps","action":"archctl hyprland toggle window-no-gaps"},
  "appearance.windows.corners": {"icon":"󰘇","label":"Window Corners"},
  "appearance.windows.corners.theme": {"icon":"󰏘","label":"Theme Corners","checked":"[[ $(arch-hyprland-corners) == \"theme\" ]]","action":"arch-hyprland-corners theme"},
  "appearance.windows.corners.sharp": {"icon":"󰝣","label":"Sharp Corners","checked":"[[ $(arch-hyprland-corners) == \"sharp\" ]]","action":"arch-hyprland-corners sharp"},
  "appearance.windows.corners.rounded": {"icon":"󰘇","label":"Rounded Corners","checked":"[[ $(arch-hyprland-corners) == \"rounded\" ]]","action":"arch-hyprland-corners rounded"},
  "appearance.windows.transparency": {"icon":"󰂵","label":"Window Opacity"},
  "appearance.windows.transparency.opaque": {"icon":"󰝤","label":"Opaque Windows","checked":"[[ $(arch-hyprland-window-transparency) == \"opaque\" ]]","action":"arch-hyprland-window-transparency opaque"},
  "appearance.windows.transparency.transparent": {"icon":"󰝣","label":"Transparent Windows","checked":"[[ $(arch-hyprland-window-transparency) == \"transparent\" ]]","action":"arch-hyprland-window-transparency transparent"},
  "appearance.windows.transparency.glassy": {"icon":"󰂵","label":"Glassy Windows","checked":"[[ $(arch-hyprland-window-transparency) == \"glassy\" ]]","action":"arch-hyprland-window-transparency glassy"},
  "appearance.windows.one-window-ratio-on": {"icon":"","label":"1-Window Ratio On","when":"! archctl hyprland toggle enabled single-window-aspect-ratio","action":"archctl hyprland window single square aspect toggle"},
  "appearance.windows.one-window-ratio-off": {"icon":"","label":"1-Window Ratio Off","when":"archctl hyprland toggle enabled single-window-aspect-ratio","action":"archctl hyprland window single square aspect toggle"},
  "appearance.branding": {"icon":"󰣇","label":"Branding"},
  "appearance.branding.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "appearance.branding.screensaver.text": {"icon":"","label":"Edit Text","action":"archctl branding screensaver text"},
  "appearance.branding.screensaver.image": {"icon":"","label":"Set From Image","action":"archctl branding screensaver image"},
  "appearance.branding.screensaver.default": {"icon":"","label":"Restore Default","action":"archctl branding screensaver reset"},
  "appearance.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","title":"Default Workspace Layout"},
  "appearance.workspace-layout.tiling": {"icon":"󱓻","label":"Tiling","checked":"[[ $(arch-hyprland-workspace-layout-default) == \"tiling\" ]]","action":"arch-hyprland-workspace-layout-default tiling"},
  "appearance.workspace-layout.scrolling": {"icon":"󰝥","label":"Scrolling","checked":"[[ $(arch-hyprland-workspace-layout-default) == \"scrolling\" ]]","action":"arch-hyprland-workspace-layout-default scrolling"},
  "appearance.animations-on": {"icon":"󰗘","label":"Animations On","when":"archctl hyprland toggle enabled no-animations","action":"archctl toggle animations on"},
  "appearance.animations-off": {"icon":"󰗘","label":"Animations Off","when":"! archctl hyprland toggle enabled no-animations","action":"archctl toggle animations off"},
  "appearance.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(arch-plymouth-switcher); if [[ $unlock == default ]]; then arch-launch-terminal-with-presentation arch-plymouth-reset; elif [[ -n $unlock ]]; then arch-launch-terminal-with-presentation \"arch-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi"},

  // Trigger
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.toggle.idle-lock-on": {"icon":"","label":"Stay Awake","when":"! archctl toggle idle enabled","action":"archctl toggle idle stay-awake"},
  "trigger.toggle.idle-lock-off": {"icon":"","label":"Allow Sleep","when":"archctl toggle idle enabled","action":"archctl toggle idle allow-idle"},
  "trigger.toggle.notifications-on": {"icon":"󰂛","label":"Notifications On","when":"[[ $(arch-shell notifications isDnd) == on ]]","action":"archctl toggle notifications"},
  "trigger.toggle.notifications-off": {"icon":"󰂛","label":"Silence Notifications","when":"[[ $(arch-shell notifications isDnd) != on ]]","action":"archctl toggle notifications"},
  "trigger.toggle.nightlight-on": {"icon":"󰔎","label":"Nightlight On","when":"[[ $(archctl toggle nightlight --status) != *'\"enabled\":true'* ]]","action":"archctl toggle nightlight on"},
  "trigger.toggle.nightlight-off": {"icon":"󰔎","label":"Nightlight Off","when":"[[ $(archctl toggle nightlight --status) == *'\"enabled\":true'* ]]","action":"archctl toggle nightlight off"},
  "trigger.toggle.screensaver-on": {"icon":"󱄄","label":"Screensaver On","when":"archctl toggle enabled screensaver-off","action":"archctl toggle screensaver"},
  "trigger.toggle.screensaver-off": {"icon":"󱄄","label":"Screensaver Off","when":"! archctl toggle enabled screensaver-off","action":"archctl toggle screensaver"},
  "trigger.toggle.crash-capture-on": {"icon":"󱚡","label":"Crash Capture On","when":"archctl toggle enabled crash-capture-off","action":"archctl toggle crash capture"},
  "trigger.toggle.crash-capture-off": {"icon":"󱚡","label":"Crash Capture Off","when":"! archctl toggle enabled crash-capture-off","action":"archctl toggle crash capture"},
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"archctl menu emoji"},
  "trigger.clipboard-history": {"icon":"󰅇","label":"Clipboard History","action":"arch-shell shell summon arch.clipboard"},
  "trigger.reminder": {"icon":"󰢌","label":"Reminder","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"arch-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"arch-capture-screenrecording --status","action":"arch-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"arch-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"arch-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"arch-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"arch-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"arch-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"archctl hw webcam","action":"arch-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"arch-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display-on": {"icon":"󰛧","label":"Laptop Display On","when":"archctl hw laptop && archctl hyprland toggle enabled internal-monitor-disable","action":"arch-hyprland-monitor-internal toggle"},
  "trigger.hardware.laptop-display-off": {"icon":"󰛧","label":"Laptop Display Off","when":"archctl hw laptop && ! archctl hyprland toggle enabled internal-monitor-disable","action":"arch-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display-on": {"icon":"󰍹","label":"Display Mirroring On","when":"archctl hw laptop && ! archctl hyprland toggle enabled internal-monitor-mirror","action":"arch-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.mirror-display-off": {"icon":"󰍹","label":"Display Mirroring Off","when":"archctl hw laptop && archctl hyprland toggle enabled internal-monitor-mirror","action":"arch-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu-on": {"icon":"","label":"Switch to Hybrid GPU","when":"archctl hw hybrid gpu && ! grep -q '\"mode\": \"Hybrid\"' /etc/supergfxd.conf","action":"arch-launch-terminal-with-presentation archctl toggle hybrid gpu"},
  "trigger.hardware.hybrid-gpu-off": {"icon":"","label":"Switch to Integrated GPU","when":"archctl hw hybrid gpu && grep -q '\"mode\": \"Hybrid\"' /etc/supergfxd.conf","action":"arch-launch-terminal-with-presentation archctl toggle hybrid gpu"},
  "trigger.hardware.touchpad-on": {"icon":"󰟸","label":"Enable Touchpad","when":"archctl hw touchpad && [[ -f ~/.local/state/arch/toggles/hypr/touchpad-disabled-name ]]","action":"archctl toggle input device touchpad on"},
  "trigger.hardware.touchpad-off": {"icon":"󰟸","label":"Disable Touchpad","when":"archctl hw touchpad && [[ ! -f ~/.local/state/arch/toggles/hypr/touchpad-disabled-name ]]","action":"archctl toggle input device touchpad off"},
  "trigger.hardware.touchscreen-on": {"icon":"󰆽","label":"Enable Touchscreen","when":"archctl hw touchscreen && [[ -f ~/.local/state/arch/toggles/hypr/touchscreen-disabled-name ]]","action":"archctl toggle input device touchscreen on"},
  "trigger.hardware.touchscreen-off": {"icon":"󰆽","label":"Disable Touchscreen","when":"archctl hw touchscreen && [[ ! -f ~/.local/state/arch/toggles/hypr/touchscreen-disabled-name ]]","action":"archctl toggle input device touchscreen off"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Set one","aliases":["reminder-set","remind"],"action":"arch-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Show all","action":"arch-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Clear all","action":"arch-reminder clear"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"arch-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"arch-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"arch-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"uwsm-app -- localsend"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Network Speed Test","action":"arch-shell shell summon arch.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Disk Speed Test","action":"arch-shell shell summon arch.disk-speedtest"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"arch-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"arch-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"arch-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.typing": {"icon":"","label":"Typing"},
  "setup.typing.keyboard": {"icon":"","label":"Keyboard Layouts","action":"arch-setup-keyboard"},
  "setup.typing.input": {"icon":"","label":"Input Methods","action":"arch-setup-input"},
  "setup.language": {"icon":"","label":"Language","provider":"languages"},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(arch-dns)\" == \"DHCP\" ]]","action":"arch-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(arch-dns)\" == \"Cloudflare\" ]]","action":"arch-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(arch-dns)\" == \"Google\" ]]","action":"arch-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(arch-dns)\" == \"Custom\" ]]","action":"arch-launch-terminal-with-presentation 'arch-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"arch-network-wifi-connected","action":"arch-shell shell summon arch.wifiqr"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","checked":"[[ \"$(archctl default browser)\" == \"chromium\" ]]","action":"archctl default browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","checked":"[[ \"$(archctl default browser)\" == \"chrome\" ]]","action":"archctl default browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","checked":"[[ \"$(archctl default browser)\" == \"brave\" ]]","action":"archctl default browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","checked":"[[ \"$(archctl default browser)\" == \"brave-origin\" ]]","action":"archctl default browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","checked":"[[ \"$(archctl default browser)\" == \"edge\" ]]","action":"archctl default browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","checked":"[[ \"$(archctl default browser)\" == \"firefox\" ]]","action":"archctl default browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","checked":"[[ \"$(archctl default browser)\" == \"zen\" ]]","action":"archctl default browser zen"},
  "setup.default.dictation": {"icon":"","label":"Dictation","title":"Default Dictation"},
  "setup.default.dictation.superwhisper": {"icon":"","label":"Superwhisper","checked":"[[ \"$(archctl default dictation)\" == \"superwhisper\" ]]","action":"archctl default dictation superwhisper"},
  "setup.default.dictation.voxtype": {"icon":"","label":"Voxtype","checked":"[[ \"$(archctl default dictation)\" == \"voxtype\" ]]","action":"archctl default dictation voxtype"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Default Terminal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","checked":"[[ \"$(archctl default terminal)\" == \"alacritty\" ]]","action":"archctl default terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","checked":"[[ \"$(archctl default terminal)\" == \"foot\" ]]","action":"archctl default terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","checked":"[[ \"$(archctl default terminal)\" == \"ghostty\" ]]","action":"archctl default terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","checked":"[[ \"$(archctl default terminal)\" == \"kitty\" ]]","action":"archctl default terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor","title":"Default Editor"},
