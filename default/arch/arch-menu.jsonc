  "remove.development.javascript.bun": {"icon":"","label":"Bun","when":"[[ -d $HOME/.local/share/mise/installs/bun ]]","action":"arch-launch-terminal-with-presentation 'arch-remove-dev-env bun'"},
  "remove.development.javascript.deno": {"icon":"","label":"Deno","when":"[[ -d $HOME/.local/share/mise/installs/deno ]]","action":"arch-launch-terminal-with-presentation 'arch-remove-dev-env deno'"},
  "remove.development.php.php": {"icon":"","label":"PHP","when":"[[ -d $HOME/.local/share/mise/installs/php ]] || arch-pkg-present php","action":"arch-launch-terminal-with-presentation 'arch-remove-dev-env php'"},
  "remove.development.php.laravel": {"icon":"","label":"Laravel","when":"[[ -x $HOME/.local/bin/laravel || -x $HOME/.config/composer/vendor/bin/laravel ]]","action":"arch-launch-terminal-with-presentation 'arch-remove-dev-env laravel'"},
  "remove.development.php.symfony": {"icon":"","label":"Symfony","when":"arch-pkg-present symfony-cli","action":"arch-launch-terminal-with-presentation 'arch-remove-dev-env symfony'"},
  "remove.development.elixir.elixir": {"icon":"","label":"Elixir","when":"[[ -d $HOME/.local/share/mise/installs/elixir ]]","action":"arch-launch-terminal-with-presentation 'arch-remove-dev-env elixir'"},
  "remove.development.elixir.phoenix": {"icon":"","label":"Phoenix","when":"[[ -d $HOME/.local/share/mise/installs/elixir ]]","action":"arch-launch-terminal-with-presentation 'arch-remove-dev-env phoenix'"},

  // Update
  "update.system": {"icon":"󰣇","label":"System Update","action":"kitty --title 'System Update' sudo pacman -Syu"},
  "update.kernel": {"icon":"","label":"Kernel","when":"(( $(arch-kernel list | wc -l) > 1 ))","provider":"kernels"},
  "update.config": {"icon":"","label":"Config","title":"Reset to default"},
  "update.process": {"icon":"","label":"Process","title":"Restart"},
  "update.hardware": {"icon":"󰇅","label":"Hardware","title":"Restart"},
  "update.firmware": {"icon":"","label":"Firmware","action":"arch-launch-terminal-with-presentation arch-update-firmware"},
  "update.password": {"icon":"","label":"Password"},
  "update.timezone": {"icon":"","label":"Timezone","action":"arch-menu-timezone"},
  "update.time": {"icon":"","label":"Time","action":"arch-launch-terminal-with-presentation arch-update-time"},
  "update.process.hyprsunset": {"icon":"","label":"Hyprsunset","action":"archctl restart app hyprsunset"},
  "update.process.shell": {"icon":"󰍜","label":"Shell","action":"arch-restart-shell"},
  "update.config.hyprland": {"icon":"","label":"Hyprland","action":"arch-launch-terminal-with-presentation arch-refresh-hyprland"},
  "update.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"arch-launch-terminal-with-presentation archctl refresh hyprsunset"},
  "update.config.plymouth": {"icon":"󱣴","label":"Plymouth","action":"arch-launch-terminal-with-presentation arch-refresh-plymouth"},
  "update.config.tmux": {"icon":"","label":"Tmux","action":"arch-launch-terminal-with-presentation archctl refresh tmux"},
  "update.config.shell": {"icon":"󰍜","label":"Shell","action":"arch-launch-terminal-with-presentation arch-refresh-shell"},
  "update.hardware.audio": {"icon":"","label":"Audio","action":"arch-launch-terminal-with-presentation arch-restart-audio"},
  "update.hardware.wifi": {"icon":"󱚾","label":"Wi-Fi","action":"arch-launch-terminal-with-presentation arch-restart-wifi"},
  "update.hardware.bluetooth": {"icon":"󰂯","label":"Bluetooth","action":"arch-launch-terminal-with-presentation arch-restart-bluetooth"},
  "update.hardware.trackpad": {"icon":"󰟸","label":"Trackpad","action":"arch-launch-terminal-with-presentation arch-restart-trackpad"},
  "update.password.drive": {"icon":"","label":"Drive Encryption","action":"arch-launch-terminal-with-presentation arch-drive-password"},
