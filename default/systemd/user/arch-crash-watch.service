[Unit]
Description=Announce process crashes
# Needs the graphical session bus to send notifications.
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# Set by archctl toggle crash capture. Checked here so a disabled watcher stays
# disabled across logins without the unit having to be disabled.
ConditionPathExists=!%h/.local/state/arch/toggles/crash-capture-off

[Service]
Type=simple
ExecStart=/usr/bin/arch-crash-watch
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
