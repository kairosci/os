{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
      "background": "glassy",
    "layout": {
      "left": [
        {
          "id": "arch.menu"
        },
        {
          "id": "arch.workspaces"
        }
      ],
      "centerBegin": [
        {
          "id": "arch.indicators"
        }
      ],
      "center": [
        {
          "id": "arch.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        }
      ],
      "centerEnd": [
        {
          "id": "arch.elsewhen"
        },
        {
          "id": "arch.weather"
        },
        {
          "id": "arch.system-update"
        }
      ],
      "right": [
        {
          "id": "arch.tray"
        },
        {
          "id": "arch.keyboard-layout"
        },
        {
          "id": "arch.bluetooth"
        },
        {
          "id": "arch.network"
        },
        {
          "id": "arch.audio"
        },
        {
          "id": "arch.monitor"
        },
        {
          "id": "arch.power"
        }
      ]
    }
  },
  "dock": {
    "position": "bottom",
    "pinned": [
      "org.gnome.Nautilus",
      "chromium",
      "foot",
      "omacalc",
      "omawrite",
      "X",
      "YouTube"
    ]
  },
  "plugins": []
}
