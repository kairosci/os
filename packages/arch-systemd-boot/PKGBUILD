# Arch desktop runtime, using the tested systemd-boot path and replacing the
# former Arch runtime package ID.
pkgname='arch'
pkgver=4.0.6
pkgrel=37
pkgdesc='Arch desktop runtime and configuration'
# The payload is architecture-independent, but the dependency set is not: the
# boot stack differs per architecture (see depends_x86_64 / depends_aarch64),
# and makepkg only honours arch-suffixed arrays on arch-specific packages.
arch=('x86_64' 'aarch64')
url='https://github.com/kairosci/arch'
license=('MIT')
install=arch-branding.install
# Hard depends: only packages whose removal would brick the desktop. The ISO
# pacstraps the full default install set from installer/arch-base.packages.
depends=(
  # Keep the runtime and system defaults from different Arch source revisions
  # from getting mixed in one install.
  "arch-settings=${pkgver}"

  # Wayland / Hyprland core
  'hyprland'
  'quickshell'
  'uwsm'
  'sddm'
  'xdg-desktop-portal-hyprland'

  # Audio / auth / portal essentials
  'wireplumber'
  'pipewire'
  'gnome-keyring'

  # Required by arch-* scripts and arch-shell
  'gum'
  'jq'
  'git'
  'perl' # /usr/bin/arch-shell invokes perl directly

  # Update availability checks (checkupdates from pacman-contrib uses fakeroot)
  'fakeroot'
  'pacman-contrib'

  # System font (UI assumes it)
  'ttf-jetbrains-mono-nerd-basic'
)

# The x86_64 install uses the Arch kernel with systemd-boot. Snapper remains
# for snapshot management; Limine and its kernel/snapshot hooks are not part
# of this boot path.
depends_x86_64=(
  'snapper'
)

# Apple Silicon boots through m1n1 + GRUB from the Asahi packages and keeps
# Arch Linux ARM's kernel and boot layout, so the Limine/Snapper stack does not
# apply. Only Apple Silicon's Broadcom Wi-Fi needs iwd, and arch-mac depends
# on it. Elsewhere the package only renames the Wi-Fi interface to wlan0
# (80-iwd.link), and a saved connection tied to the old name stops connecting.
depends_aarch64=(
  'networkmanager'
)

makedepends=(
  'git'
  'python'
)

# Build only from the Arch fork checkout. Pulling upstream here would silently
# discard the Arch branding, migrations, and systemd-boot fixes in this repo.
source=()
sha256sums=()

prepare() {
  [[ -n "${ARCH_SRC:-}" ]] || {
    error 'Set ARCH_SRC to the Arch checkout that this package should build.'
    return 1
  }
  mkdir -p "$srcdir/arch"
  git -C "$ARCH_SRC" archive --format=tar HEAD | tar -x -C "$srcdir/arch"
  python3 "$srcdir/arch/scripts/modules.py" validate --package "$pkgname"
}

package() {
  cd "$srcdir/arch"

  # Assemble package-owned files from the module catalog. The catalog owns
  # each source-to-package path; this package function only creates command
  # entry points and applies the verified boot-path exclusions.
  local module_stage
  module_stage=$(mktemp -d "$srcdir/arch-modules.XXXXXXXX")
  python3 scripts/modules.py assemble --package "$pkgname" --destination "$module_stage"

  install -d "$pkgdir/usr/bin"
  for bin in "$module_stage/usr/share/arch/bin"/*; do
    [[ -f $bin ]] || continue
    local base
    base=$(basename "$bin")
    case "$base" in
      arch-debug|arch-debug-idle|arch-upload-log)
        rm -f "$bin"
        continue
        ;;
      arch-refresh-limine)
        # This runtime package targets the verified Arch UKI/systemd-boot path.
        rm -f "$bin"
        continue
        ;;
    esac
    install -Dm755 "$bin" "$pkgdir/usr/bin/$base"
    rm -f "$bin"
    ln -s "/usr/bin/$base" "$bin"
  done

  cp -a "$module_stage/." "$pkgdir/"
  rm -rf "$module_stage"

  # Fresh users created after install are already on the package layout in this
  # build, so seed migration markers through /etc/skel. Existing users keep
  # their own state and still run pending migrations on update.
  if compgen -G "$pkgdir/usr/share/arch/migrations/*.sh" >/dev/null; then
    install -d "$pkgdir/etc/skel/.local/state/arch/migrations"
    for migration in "$pkgdir/usr/share/arch/migrations"/*.sh; do
      touch "$pkgdir/etc/skel/.local/state/arch/migrations/$(basename "$migration")"
    done
  fi
}
