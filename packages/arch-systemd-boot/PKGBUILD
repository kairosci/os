# Arch desktop runtime, using the tested systemd-boot path and replacing the
# former Arch runtime package ID.
pkgname='arch'
pkgver=4.0.6
pkgrel=37
pkgdesc='Arch desktop runtime and configuration'
# The payload is architecture-independent, but the dependency set is not: the
# boot stack differs per architecture (see depends_x86_64 / depends_aarch64),
# and makepkg only honours arch-suffixed arrays on arch-specific packages.
arch=('x86_64' 'aarch64')
url='https://github.com/kairosci/arch'
license=('MIT')
install=arch-branding.install
# Hard depends: only packages whose removal would brick the desktop. The ISO
# pacstraps the full default install set from installer/arch-base.packages.
depends=(
  # Keep the runtime and system defaults from different Arch source revisions
  # from getting mixed in one install.
  "arch-settings=${pkgver}"

  # Wayland / Hyprland core
  'hyprland'
  'quickshell'
  'uwsm'
  'sddm'
  'xdg-desktop-portal-hyprland'

  # Audio / auth / portal essentials
  'wireplumber'
  'pipewire'
  'gnome-keyring'

  # Required by arch-* scripts and arch-shell
  'gum'
  'jq'
  'git'
  'perl' # /usr/bin/arch-shell invokes perl directly

  # Update availability checks (checkupdates from pacman-contrib uses fakeroot)
  'fakeroot'
  'pacman-contrib'

  # System font (UI assumes it)
  'ttf-jetbrains-mono-nerd-basic'
)

# The x86_64 install uses the Arch kernel with systemd-boot. Snapper remains
# for snapshot management; Limine and its kernel/snapshot hooks are not part
# of this boot path.
depends_x86_64=(
  'snapper'
)

# Apple Silicon boots through m1n1 + GRUB from the Asahi packages and keeps
# Arch Linux ARM's kernel and boot layout, so the Limine/Snapper stack does not
# apply. Only Apple Silicon's Broadcom Wi-Fi needs iwd, and arch-mac depends
# on it. Elsewhere the package only renames the Wi-Fi interface to wlan0
# (80-iwd.link), and a saved connection tied to the old name stops connecting.
depends_aarch64=(
  'networkmanager'
)

makedepends=(
  'git'
  'python'
)

# Build only from the Arch fork checkout. Pulling upstream here would silently
# discard the Arch branding, migrations, and systemd-boot fixes in this repo.
source=()
sha256sums=()

prepare() {
  [[ -n "${ARCH_SRC:-}" ]] || {
    error 'Set ARCH_SRC to the Arch checkout that this package should build.'
    return 1
  }
  mkdir -p "$srcdir/arch"
  git -C "$ARCH_SRC" archive --format=tar HEAD | tar -x -C "$srcdir/arch"
  python3 "$srcdir/arch/scripts/modules.py" validate --package "$pkgname"
}

package() {
  cd "$srcdir/arch"

  # Runtime binaries — ship everything in bin/ except the debug helpers
  # that ship from arch-settings (needed before this package is installed,
  # e.g. on the ISO live env). Keep the sudo revocation hook and its helpers
  # together in this package; the installed settings package does not own them.
  install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/arch/bin"
  for bin in bin/*; do
    [[ -f $bin ]] || continue
    local base
    base=$(basename "$bin")
    case "$base" in
      arch-debug|arch-debug-idle|arch-upload-log)
        continue
        ;;
      arch-refresh-limine)
        # This runtime package targets the verified Arch UKI/systemd-boot path.
        continue
        ;;
    esac
    install -Dm755 "$bin" "$pkgdir/usr/bin/$base"
    ln -s "/usr/bin/$base" "$pkgdir/usr/share/arch/bin/$base"
  done

  # Keep Hyprland live config reloads paused while settings files are replaced.
  # Arch package upgrades remain managed directly by pacman; omit the fork's
  # update guard so it does not block native transactions.
  install -Dm644 default/libalpm/hooks/10-arch-hyprland-reload-pause.hook "$pkgdir/usr/share/libalpm/hooks/10-arch-hyprland-reload-pause.hook"
  install -Dm644 default/libalpm/hooks/90-arch-hyprland-reload-resume.hook "$pkgdir/usr/share/libalpm/hooks/90-arch-hyprland-reload-resume.hook"

  # Target-side setup scripts and package lists used by ISO finalization,
  # first login, future users, migrations, and reinstall/reset commands.
  cp -a install "$pkgdir/usr/share/arch/"

  # Assemble the shared shell runtime and its independently owned plugins
  # from their module manifests into the installed tree.
  local module_stage
  module_stage=$(mktemp -d "$srcdir/arch-modules.XXXXXXXX")
  python3 scripts/modules.py assemble --package "$pkgname" \
    --module desktop.runtime --module 'desktop.shell.*' \
    --destination "$module_stage"
  cp -a "$module_stage/usr/share/arch/." "$pkgdir/usr/share/arch/"
  rm -rf "$module_stage"

  # Versioned migrations runner reads from this tree.
  cp -a migrations "$pkgdir/usr/share/arch/"

  # Shared system defaults referenced by migrations and first-run repair tools.
  cp -a etc "$pkgdir/usr/share/arch/"

  # Fresh users created after install are already on the package layout in this
  # build, so seed migration markers through /etc/skel. Existing users keep
  # their own state and still run pending migrations on update.
  if compgen -G 'migrations/*.sh' >/dev/null; then
    install -d "$pkgdir/etc/skel/.local/state/arch/migrations"
    for migration in migrations/*.sh; do
      touch "$pkgdir/etc/skel/.local/state/arch/migrations/$(basename "$migration")"
    done
  fi
  # Runtime version file.
  install -Dm644 version "$pkgdir/usr/share/arch/version"

  # Arch marks used by the shell launcher, lock screen, About, and screensaver.
  install -Dm644 arch-mark.svg "$pkgdir/usr/share/arch/arch-mark.svg"
  install -Dm644 icon.txt "$pkgdir/usr/share/arch/icon.txt"
  install -Dm644 logo.txt "$pkgdir/usr/share/arch/logo.txt"
  install -Dm644 logo.svg "$pkgdir/usr/share/arch/logo.svg"

}
