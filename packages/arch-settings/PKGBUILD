pkgname=arch-settings
pkgver=4.0.6
pkgrel=8
pkgdesc='Arch desktop defaults, system configuration, and greeter assets'
arch=('x86_64' 'aarch64')
url='https://github.com/kairosci/os'
license=('MIT')
depends=('bash' 'curl' 'gum' 'hicolor-icon-theme' 'plymouth' 'sudo')
makedepends=('git' 'imagemagick' 'python')
backup=(
  'etc/docker/daemon.json'
  'etc/fastfetch/config.jsonc'
  'etc/gnupg/dirmngr.conf'
  'etc/mkinitcpio.conf.d/00-arch-hooks.conf'
  'etc/mkinitcpio.conf.d/arch_hooks.conf'
  'etc/mkinitcpio.conf.d/arch_vconsole.conf'
  'etc/mkinitcpio.conf.d/thunderbolt_module.conf'
  'etc/sddm.conf.d/10-theme.conf'
  'etc/sddm.conf.d/10-wayland.conf'
)
install=arch-settings.install
source=()
sha256sums=()

prepare() {
  [[ -n ${ARCH_SRC:-} ]] || {
    error 'Set ARCH_SRC to the Arch checkout that this package should build.'
    return 1
  }
  mkdir -p "$srcdir/arch"
  git -C "$ARCH_SRC" archive --format=tar HEAD | tar -x -C "$srcdir/arch"
  python3 "$srcdir/arch/scripts/modules.py" validate --package "$pkgname"
}

package() {
  cd "$srcdir/arch"

  # Package payload paths are assembled from the module catalog. The steps
  # below handle only transformations and package-manager metadata.
  local module_stage
  module_stage=$(mktemp -d "$srcdir/arch-settings-modules.XXXXXXXX")
  python3 scripts/modules.py assemble --package "$pkgname" --destination "$module_stage"
  cp -a "$module_stage/." "$pkgdir/"
  rm -rf "$module_stage"

  # Seed new accounts with the same Arch config tree used by existing users.
  install -d "$pkgdir/etc/skel/.config" "$pkgdir/etc/skel/.local/share/applications"
  cp -a "$pkgdir/usr/share/arch/config/." "$pkgdir/etc/skel/.config/"
  if compgen -G "$pkgdir/usr/share/arch/assets/applications/*.desktop" >/dev/null; then
    cp "$pkgdir/usr/share/arch/assets/applications"/*.desktop "$pkgdir/etc/skel/.local/share/applications/"
  fi

  # Arch-owned system settings. System-owned files are staged under
  # /usr/share/arch/etc-overrides and published by the package scriptlet.
  install -d "$pkgdir/usr/share/arch/etc-overrides"
  for path in \
    etc/os-release \
    etc/nsswitch.conf \
    etc/security/faillock.conf \
    etc/cups/cups-browsed.conf \
    etc/cups/cups-files.conf \
    etc/plymouth/plymouthd.conf; do
    [[ -f $pkgdir/$path ]] || continue
    case "$path" in
      etc/os-release) target=os-release ;;
      etc/nsswitch.conf) target=nsswitch.conf ;;
      etc/security/faillock.conf) target=security-faillock.conf ;;
      etc/cups/cups-browsed.conf) target=cups-browsed.conf ;;
      etc/cups/cups-files.conf) target=cups-files.conf ;;
      etc/plymouth/plymouthd.conf) target=plymouthd.conf ;;
    esac
    install -Dm644 "$pkgdir/$path" "$pkgdir/usr/share/arch/etc-overrides/$target"
    rm -f "$pkgdir/$path"
  done
  rm -rf "$pkgdir/etc/limine-entry-tool.d"
  rm -f "$pkgdir/etc/mise/conf.d/arch.toml" \
    "$pkgdir/etc/mise/conf.d/arch-tools.toml"
  rmdir "$pkgdir/etc/limine-entry-tool.d" "$pkgdir/etc/security" "$pkgdir/etc/cups" \
    "$pkgdir/etc/plymouth" 2>/dev/null || true
  if [[ -d $pkgdir/etc/sudoers.d ]]; then
    chmod 0750 "$pkgdir/etc/sudoers.d"
    chmod 0440 "$pkgdir/etc/sudoers.d"/*
  fi

  # Translate the source desktop's bundled icons into standard hicolor sizes.
  for icon in assets/applications/icons/*; do
    [[ -f $icon ]] || continue
    icon_name=$(basename "$icon")
    icon_id=$(printf '%s\n' "${icon_name%.*}" \
      | tr '[:upper:]' '[:lower:]' \
      | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
    case "$icon" in
      *.svg)
        install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$icon_id.svg"
        ;;
      *)
        install -d "$pkgdir/usr/share/icons/hicolor/256x256/apps" \
          "$pkgdir/usr/share/icons/hicolor/48x48/apps"
        magick "$icon" -thumbnail 256x256 -background transparent -gravity center -extent 256x256 \
          "PNG32:$pkgdir/usr/share/icons/hicolor/256x256/apps/$icon_id.png"
        magick "$icon" -thumbnail 48x48 -background transparent -gravity center -extent 48x48 \
          "PNG32:$pkgdir/usr/share/icons/hicolor/48x48/apps/$icon_id.png"
        ;;
    esac
  done

}
