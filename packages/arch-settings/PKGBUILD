pkgname=arch-settings
pkgver=4.0.6
pkgrel=8
pkgdesc='Arch desktop defaults, system configuration, and greeter assets'
arch=('x86_64' 'aarch64')
url='https://github.com/kairosci/arch'
license=('MIT')
depends=('bash' 'curl' 'gum' 'hicolor-icon-theme' 'plymouth' 'sudo')
makedepends=('git' 'imagemagick' 'python')
backup=(
  'etc/docker/daemon.json'
  'etc/fastfetch/config.jsonc'
  'etc/gnupg/dirmngr.conf'
  'etc/mkinitcpio.conf.d/00-arch-hooks.conf'
  'etc/mkinitcpio.conf.d/arch_hooks.conf'
  'etc/mkinitcpio.conf.d/arch_vconsole.conf'
  'etc/mkinitcpio.conf.d/thunderbolt_module.conf'
  'etc/sddm.conf.d/10-theme.conf'
  'etc/sddm.conf.d/10-wayland.conf'
)
install=arch-settings.install
source=()
sha256sums=()

prepare() {
  [[ -n ${ARCH_SRC:-} ]] || {
    error 'Set ARCH_SRC to the Arch checkout that this package should build.'
    return 1
  }
  mkdir -p "$srcdir/arch"
  git -C "$ARCH_SRC" archive --format=tar HEAD | tar -x -C "$srcdir/arch"
  python3 "$srcdir/arch/scripts/modules.py" validate --package "$pkgname"
}

package() {
  cd "$srcdir/arch"

  # Shared configuration, desktop entries, and defaults are owned by this
  # package so /usr/share/arch has one source of truth.
  install -d "$pkgdir/usr/share/arch"
  cp -a config default "$pkgdir/usr/share/arch/"
  cp -a assets/applications "$pkgdir/usr/share/arch/applications"

  # Seed new accounts with the same Arch config tree used by existing users.
  install -d "$pkgdir/etc/skel/.config" "$pkgdir/etc/skel/.local/share/applications"
  cp -a config/. "$pkgdir/etc/skel/.config/"
  if compgen -G 'assets/applications/*.desktop' >/dev/null; then
    cp assets/applications/*.desktop "$pkgdir/etc/skel/.local/share/applications/"
  fi
  install -Dm644 logo.txt "$pkgdir/etc/skel/.config/arch/branding/screensaver.txt"
  install -Dm644 icon.txt "$pkgdir/etc/skel/.config/arch/branding/about.txt"

  # Arch-owned system settings. System-owned files are staged under
  # /usr/share/arch/etc-overrides and published by the package scriptlet.
  install -d "$pkgdir/etc" "$pkgdir/usr/share/arch/etc-overrides"
  cp -a etc/. "$pkgdir/etc/"
  for path in \
    etc/os-release \
    etc/nsswitch.conf \
    etc/security/faillock.conf \
    etc/cups/cups-browsed.conf \
    etc/cups/cups-files.conf \
    etc/plymouth/plymouthd.conf; do
    [[ -f $pkgdir/$path ]] || continue
    case "$path" in
      etc/os-release) target=os-release ;;
      etc/nsswitch.conf) target=nsswitch.conf ;;
      etc/security/faillock.conf) target=security-faillock.conf ;;
      etc/cups/cups-browsed.conf) target=cups-browsed.conf ;;
      etc/cups/cups-files.conf) target=cups-files.conf ;;
      etc/plymouth/plymouthd.conf) target=plymouthd.conf ;;
    esac
    install -Dm644 "$pkgdir/$path" "$pkgdir/usr/share/arch/etc-overrides/$target"
    rm -f "$pkgdir/$path"
  done
  rm -rf "$pkgdir/etc/limine-entry-tool.d"
  rm -f "$pkgdir/etc/mise/conf.d/arch.toml" \
    "$pkgdir/etc/mise/conf.d/arch-tools.toml"
  rmdir "$pkgdir/etc/limine-entry-tool.d" "$pkgdir/etc/security" "$pkgdir/etc/cups" \
    "$pkgdir/etc/plymouth" 2>/dev/null || true
  if [[ -d $pkgdir/etc/sudoers.d ]]; then
    chmod 0750 "$pkgdir/etc/sudoers.d"
    chmod 0440 "$pkgdir/etc/sudoers.d"/*
  fi

  # Translate the source desktop's bundled icons into standard hicolor sizes.
  for icon in assets/applications/icons/*; do
    [[ -f $icon ]] || continue
    icon_name=$(basename "$icon")
    icon_id=$(printf '%s\n' "${icon_name%.*}" \
      | tr '[:upper:]' '[:lower:]' \
      | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
    case "$icon" in
      *.svg)
        install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$icon_id.svg"
        ;;
      *)
        install -d "$pkgdir/usr/share/icons/hicolor/256x256/apps" \
          "$pkgdir/usr/share/icons/hicolor/48x48/apps"
        magick "$icon" -thumbnail 256x256 -background transparent -gravity center -extent 256x256 \
          "PNG32:$pkgdir/usr/share/icons/hicolor/256x256/apps/$icon_id.png"
        magick "$icon" -thumbnail 48x48 -background transparent -gravity center -extent 48x48 \
          "PNG32:$pkgdir/usr/share/icons/hicolor/48x48/apps/$icon_id.png"
        ;;
    esac
  done

  # The session environment, fonts, and terminal preferences used before a
  # user profile has run.
  install -Dm644 default/uwsm/env.d/10-arch "$pkgdir/usr/share/uwsm/env.d/10-arch"
  install -Dm644 default/environment.d/10-arch-fcitx.conf \
    "$pkgdir/usr/lib/environment.d/10-arch-fcitx.conf"
  install -Dm644 default/xdg-terminal-exec/hyprland-xdg-terminals.list \
    "$pkgdir/usr/share/xdg-terminal-exec/hyprland-xdg-terminals.list"
  install -Dm644 default/applications/mimeapps.list \
    "$pkgdir/usr/share/applications/mimeapps.list"
  install -Dm644 default/fonts/arch/arch.ttf \
    "$pkgdir/usr/share/fonts/arch/arch.ttf"
  install -Dm644 default/sddm/hyprland.lua "$pkgdir/usr/share/sddm/hyprland.lua"

  # The login and boot splash assets are available as soon as this package is
  # installed, including the installer's live environment.
  install -d "$pkgdir/usr/share/sddm/themes/arch" "$pkgdir/usr/share/plymouth/themes/arch"
  cp -a default/sddm/arch/. "$pkgdir/usr/share/sddm/themes/arch/"
  cp -a default/plymouth/. "$pkgdir/usr/share/plymouth/themes/arch/"
  install -Dm644 icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/arch.png"

  # Package-owned services and system defaults referenced by setup commands.
  install -d "$pkgdir/usr/lib/systemd/user" "$pkgdir/usr/lib/systemd/system"
  cp -a default/systemd/user/. "$pkgdir/usr/lib/systemd/user/"
  cp -a default/systemd/system/. "$pkgdir/usr/lib/systemd/system/"
  install -Dm755 default/systemd/system-sleep/unmount-fuse \
    "$pkgdir/usr/lib/systemd/system-sleep/unmount-fuse"
  install -Dm644 default/systemd/zram-generator.conf.d/90-arch.conf \
    "$pkgdir/usr/lib/systemd/zram-generator.conf.d/90-arch.conf"

  # Support commands needed in the live installer before the runtime arrives.
  for command in arch-debug arch-debug-idle arch-upload-log; do
    install -Dm755 "src/cli/$command" "$pkgdir/usr/bin/$command"
  done
}
