#!/bin/bash

# arch:summary=Remove the GeForce NOW Flatpak app and its data.
# arch:group=remove
# arch:name=gaming geforce-now

set -e

if arch-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
