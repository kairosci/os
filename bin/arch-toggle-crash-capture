#!/bin/bash

# arch:summary=Toggle crash capture notifications

# nf-md-robot_dead, escaped so this file reads without a Nerd Font.
readonly CRASH_GLYPH=$'\U000f16a1'

arch-toggle crash-capture-off

# The unit checks the same flag with ConditionPathExists, so stopping and
# starting only settles this session; the next login reads the flag itself.
if arch-toggle-enabled crash-capture-off; then
  systemctl --user stop arch-crash-watch.service
  arch-notification-send -g "$CRASH_GLYPH" "$(arch-i18n crash.captureDisabled)"
else
  systemctl --user start arch-crash-watch.service
  arch-notification-send -g "$CRASH_GLYPH" "$(arch-i18n crash.captureEnabled)"
fi
