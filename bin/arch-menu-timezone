#!/bin/bash

# arch:summary=Select and set the system timezone
# arch:group=menu
# arch:name=timezone

set -e

timezone=$(timedatectl list-timezones | arch-menu-select "$(arch-i18n timezone.setTitle)" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
arch-shell -q arch.clock refresh
arch-notification-send "$(arch-i18n timezone.changed "$timezone")"
