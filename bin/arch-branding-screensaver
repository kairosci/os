#!/bin/bash

# arch:summary=Edit, set, or reset screensaver branding
# arch:group=branding
# arch:name=screensaver
# arch:args=<image|text|reset>
# arch:examples=archctl branding screensaver image | archctl branding screensaver text | archctl branding screensaver reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(arch-file-select --title "$(arch-i18n branding.pickScreensaverImage)" --extensions "png svg")
  if arch-transcode-ascii "$image" ~/.config/arch/branding/screensaver.txt; then
    arch-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  arch-launch-editor ~/.config/arch/branding/screensaver.txt >/dev/null 2>&1 && arch-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$ARCH_PATH/logo.txt" ~/.config/arch/branding/screensaver.txt && arch-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: arch-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
