#!/bin/bash

# arch:summary=Cycle to the next media source and transfer playback when the current source is playing
# arch:args=[next|previous]
# arch:examples=archctl audio source switch | arch-audio-source-switch previous

direction="${1:-next}"

case "$direction" in
  next)
    arch-shell media sourceSwitch
    ;;
  previous)
    arch-shell media sourceSwitchPrevious
    ;;
  *)
    echo "Usage: arch-audio-source-switch [next|previous]" >&2
    exit 1
    ;;
esac
