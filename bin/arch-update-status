#!/bin/bash

# arch:summary=Clear the shell update indicator after an update
# arch:hidden=true

# arch-update now clears the indicator itself. This stays for an update
# started by an older arch-update: its pipeline was parsed before the
# upgrade replaced it, and still calls this right after a full upgrade that
# went through, so there is nothing left for the indicator to show.
arch-shell -q arch.system-update clear
